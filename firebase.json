{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "target": "principal",
      "rules": "storage.rules"
    },
    {
      "target": "portaria",
      "rules": "storage-portaria.rules"
    },
    {
      "target": "backups",
      "rules": "storage-backups.rules"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "cleanUrls": false,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "scripts/**",
      "servidor-nextcloud/**",
      "maestro-app/**",
      "maestro-extensao/**",
      "cloudflare/**",
      "*.md",
      "*.rules",
      "cors.json",
      "firestore.indexes.json",
      "p0.png",
      "p1.png",
      "qp*.png",
      "CNAME"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ]
  }
}