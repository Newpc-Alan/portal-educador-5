rules_version = '2';
// Storage do Portal 5.0: arquivos gerados por cada professor.
// Acervo: o da NEWPC em acervo/{botao}/..., o de cada rede em acervo-rede/{municipio}/... (ate 100 MB por arquivo).
service firebase.storage {
  match /b/{bucket}/o {

    function eu() { return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data; }
    function admin() { return request.auth != null && eu().perfil == "admin" && eu().status == "ativo"; }
    // mesma regra de licenca do Firestore: institucional (contrato vigente) ou avulsa/teste/cortesia no prazo
    function licenciado() {
      return request.auth != null && eu().status == "ativo" && (eu().perfil == "admin" ||
        (eu().get("licenca_tipo", "institucional") == "institucional" && eu().get("escola_id", null) != null) ||
        (eu().get("licenca_tipo", "institucional") != "institucional" && eu().get("licenca_fim", null) != null && eu().licenca_fim > request.time));
    }
    // ate 20 MB por arquivo; PDF, imagens, Word, Excel, PowerPoint e audio
    function arquivoValido() {
      return request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|audio/.*|application/vnd\\.openxmlformats-officedocument\\..*|application/msword|application/vnd\\.ms-excel|application/vnd\\.ms-powerpoint');
    }

    // aulas da Lousa (JSON compactado), ate 50 MB
    match /professores/{uid}/lousa/{arquivo} {
      allow read: if (request.auth != null && request.auth.uid == uid && licenciado()) || admin();
      allow create, update: if request.auth != null && request.auth.uid == uid && licenciado()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('application/gzip|application/json');
      allow delete: if (request.auth != null && request.auth.uid == uid) || admin();
    }

    // Minhas provas e banco de questoes do Gerador de Provas (JSON compactado), ate 50 MB
    match /professores/{uid}/provas/{arquivo} {
      allow read: if (request.auth != null && request.auth.uid == uid && licenciado()) || admin();
      allow create, update: if request.auth != null && request.auth.uid == uid && licenciado()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('application/gzip|application/json');
      allow delete: if (request.auth != null && request.auth.uid == uid) || admin();
    }

    // Portal do Educador TV: fotos e videos das escolas (a TV le pelo link com token gerado no envio)
    function equipeTvEscola(esc) {
      return request.auth != null && eu().status == "ativo" && (eu().perfil == "admin"
        || (licenciado() && esc in eu().get("escolas_ids", [eu().get("escola_id", "")]))
        || (eu().perfil == "gestor" && esc in eu().get("escolas_ids", [eu().get("escola_id", "")]))
        || (eu().perfil == "secretaria" && firestore.get(/databases/(default)/documents/escolas/$(esc)).data.municipio_id == eu().get("municipio_id", "-")));
    }
    match /tv/escolas/{esc}/{arquivo} {
      allow read: if request.auth != null;
      allow create: if equipeTvEscola(esc) && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)|video/(mp4|webm)');
      allow delete: if equipeTvEscola(esc);
    }
    match /tv/campanhas/{arquivo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && eu().status == "ativo" && eu().perfil == "admin"
        && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && eu().status == "ativo" && eu().perfil == "admin";
    }
    match /tv/municipios/{m}/{arquivo} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && eu().status == "ativo" && (eu().perfil == "admin" || (eu().perfil == "secretaria" && eu().get("municipio_id", "-") == m))
        && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && eu().status == "ativo" && (eu().perfil == "admin" || (eu().perfil == "secretaria" && eu().get("municipio_id", "-") == m));
    }

    // pasta de cada professor: so ele (e o administrador) acessa
    // envio para a turma (link/arquivo do professor): sobe aqui e a função copia para a pasta da turma; até 100 MB (vídeo)
    match /professores/{uid}/turma/{arquivo} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && eu().status == "ativo"
        && eu().perfil in ["professor", "gestor", "secretaria", "admin"]
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|audio/.*|video/(mp4|webm|quicktime)|application/vnd\\.openxmlformats-officedocument\\..*|application/msword|application/vnd\\.ms-excel|application/vnd\\.ms-powerpoint');
    }
    match /professores/{uid}/{arquivo=**} {
      allow read: if (request.auth != null && request.auth.uid == uid && licenciado()) || admin();
      allow create, update: if request.auth != null && request.auth.uid == uid && licenciado() && arquivoValido();
      allow delete: if (request.auth != null && request.auth.uid == uid) || admin();
    }

    // Portal IA: imagens geradas pela função; só o dono lê
    match /portal-ia/{uid}/{arquivo} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Portal IA na rede: cópias das imagens dos materiais compartilhados; só quem é da rede lê
    match /portal-ia-rede/{mun}/{id}/{arquivo} {
      allow read: if request.auth != null && eu().status == "ativo" && (eu().perfil == "admin" || eu().get("municipio_id", "-") == mun);
      allow write: if false;
    }

    // capas dos catalogos (jogos etc.): so o administrador envia; a leitura e pelo link com token gerado no envio
    match /capas/{tipo}/{arquivo} {
      allow read: if request.auth != null;
      allow create, update: if admin() && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if admin();
    }

    // Biblioteca: livros, audiolivros e gibis (gravados só pela função de importação, depois da licença confirmada)
    match /biblioteca/{caminho=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Histórias Educativas: o administrador envia o PDF (até 100 MB) e a capa direto pelo painel da estante
    match /biblioteca/historias/{arquivo} {
      allow read: if request.auth != null;
      allow create: if admin() && arquivo.matches("^[a-z0-9-]+(\\.pdf|-capa\\.jpg)$")
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType == "application/pdf" || request.resource.contentType == "image/jpeg");
      allow delete: if admin();
    }

    // demais estantes: o administrador envia PDF, áudio (MP3/M4A) ou gibi (CBZ) e a capa direto pelo painel da Biblioteca
    // Documentação do Portal: "interno" só a equipe NEWPC; "publico" qualquer pessoa com cadastro ativo (Ajuda). Só o admin envia, em PDF
    function docPdf(arquivo) { return arquivo.matches("^[A-Za-z0-9_-]+\\.pdf$") && request.resource.size < 80 * 1024 * 1024 && request.resource.contentType == "application/pdf"; }
    // aplicativos Android (APK, ex.: Portal Maestro para tablets): só na pasta interna, só o administrador
    function docApk(arquivo) { return arquivo.matches("^[A-Za-z0-9_-]+\\.apk$") && request.resource.size < 80 * 1024 * 1024 && request.resource.contentType == "application/vnd.android.package-archive"; }
    match /documentos/interno/{arquivo} {
      allow read, delete: if admin();
      allow create: if admin() && (docPdf(arquivo) || docApk(arquivo));
    }
    match /documentos/publico/{arquivo} {
      allow read: if request.auth != null && eu().status == "ativo";
      allow delete: if admin();
      allow create: if admin() && docPdf(arquivo);
    }

    // Ficha do Aluno: histórico escolar, laudos, certidão e comprovantes (PDF ou foto), só a gestão e a secretaria escolar da escola
    function equipeEscolaSt(esc) {
      return request.auth != null && eu().status == "ativo" && eu().perfil in ["gestor", "secretaria_escolar"]
        && esc in eu().get("escolas_ids", [eu().get("escola_id", "")]);
    }
    function portariaSt(esc) { return request.auth != null && eu().status == "ativo" && eu().perfil == "portaria" && esc in eu().get("escolas_ids", [eu().get("escola_id", "")]); }
    function professorSt(esc) { return licenciado() && eu().perfil == "professor" && esc in eu().get("escolas_ids", [eu().get("escola_id", "")]); }
    function fotoCadastro(arquivo) { return arquivo.matches("^[A-Za-z0-9_-]{1,60}[.]jpg$") && request.resource.size < 1024 * 1024 && request.resource.contentType == "image/jpeg"; }
    // foto do aluno (cadastro): a escola tira; professor, portaria e gestão da escola veem; nunca link público
    match /fotos_alunos/{esc}/{aluno}/{arquivo} {
      allow read: if admin() || equipeEscolaSt(esc) || portariaSt(esc) || professorSt(esc);
      allow create: if (admin() || equipeEscolaSt(esc)) && fotoCadastro(arquivo);
      allow delete: if admin() || equipeEscolaSt(esc);
    }
    // foto de quem está autorizado a buscar o aluno: só a escola e a portaria
    match /fotos_autorizados/{esc}/{aluno}/{arquivo} {
      allow read: if admin() || equipeEscolaSt(esc) || portariaSt(esc);
      allow create: if (admin() || equipeEscolaSt(esc)) && fotoCadastro(arquivo);
      allow delete: if admin() || equipeEscolaSt(esc);
    }
    // Ficha do Servidor: foto (crachá) e documentos (diploma, certificados, portaria). O próprio servidor, a gestão das escolas dele e a Secretaria de Educação
    function servDoc(email) { return firestore.get(/databases/(default)/documents/servidores/$(email)).data; }
    function donoServ(email) { return request.auth != null && request.auth.token.get("email", "") is string && request.auth.token.get("email", "").lower() == email && request.auth.token.get("email_verified", false) == true; }
    function equipeServ(email) {
      return request.auth != null && eu().status == "ativo" && (eu().perfil == "admin"
        || (eu().perfil == "secretaria" && servDoc(email).municipio_id == eu().get("municipio_id", "-"))
        || (eu().perfil == "gestor" && servDoc(email).escolas_ids.hasAny(eu().get("escolas_ids", [eu().get("escola_id", "")]))));
    }
    match /servidores/{email}/{arquivo} {
      allow read, delete: if donoServ(email) || equipeServ(email);
      allow create: if (donoServ(email) || equipeServ(email))
        && ((arquivo.matches("^foto-[A-Za-z0-9_-]{1,40}[.]jpg$") && request.resource.size < 1024 * 1024 && request.resource.contentType == "image/jpeg")
          || (arquivo.matches("^doc-[A-Za-z0-9_-]{1,80}[.](pdf|jpg|png)$") && request.resource.size < 15 * 1024 * 1024 && request.resource.contentType in ["application/pdf", "image/jpeg", "image/png"]));
    }
    match /alunos_docs/{esc}/{aluno}/{arquivo} {
      allow read, delete: if admin() || equipeEscolaSt(esc);
      allow create: if (admin() || equipeEscolaSt(esc)) && arquivo.matches("^[A-Za-z0-9_-]{1,90}[.](pdf|jpg|png)$")
        && request.resource.size < 15 * 1024 * 1024 && request.resource.contentType in ["application/pdf", "image/jpeg", "image/png"];
    }

    match /biblioteca/{secao}/{arquivo} {
      allow read: if request.auth != null;
      allow create: if admin() && secao in ["livros", "audiolivros", "aprender", "gibiteca"]
        && arquivo.matches("^[a-z0-9-]+(\\.pdf|\\.cbz|\\.mp3|\\.m4a|-capa\\.jpg)$")
        && request.resource.size < 300 * 1024 * 1024
        && request.resource.contentType in ["application/pdf", "application/zip", "audio/mpeg", "audio/mp4", "image/jpeg"];
      allow delete: if admin() && secao in ["livros", "audiolivros", "aprender", "gibiteca"];
    }

    // Atividades prontas: a sincronização com o Drive grava pelo servidor; o administrador também envia PDF ou imagem pelo painel
    match /atividades/{etapa}/{arquivo} {
      allow read: if request.auth != null;
      allow create: if admin() && etapa in ["infantil", "alfa", "iniciais", "finais", "medio", "inclusiva"]
        && arquivo.matches("^[A-Za-z0-9_-]+(\\.pdf|\\.png|\\.jpg|-mini\\.jpg)$")
        && request.resource.size < 60 * 1024 * 1024
        && request.resource.contentType in ["application/pdf", "image/png", "image/jpeg"];
      allow delete: if admin();
    }

    // Desenhos para Colorir: imagens do acervo (leitura com login; envio so do administrador)
    match /colorir/{caminho=**} {
      allow read: if request.auth != null;
      allow create, update: if admin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if admin();
    }

    // Dicas do Professor: anexos do envio (ate 10 MB cada). Publicados ficam visiveis para a rede.
    match /dicas/{uid}/{envio}/{arquivo} {
      allow create: if request.auth != null && request.auth.uid == uid && eu().status == "ativo"
        && arquivoValido() && request.resource.size < 10 * 1024 * 1024;
      allow read: if (request.auth != null && request.auth.uid == uid) || admin()
        || (request.auth != null && eu().status == "ativo"
            && firestore.get(/databases/(default)/documents/dicas_envios/$(envio)).data.status == "publicado");
      allow update: if false;
      allow delete: if admin();
    }

    // Formação Continuada: capas e materiais dos cursos (somente criação; versões antigas preservadas)
    function fEditor() { return request.auth != null && (request.auth.token.get('papel', '') in ['admin', 'editor'] || admin()); }
    function fImagem() { return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif']; }
    function fPermitido() {
      return fImagem() || request.resource.contentType in [
        'application/pdf', 'application/msword', 'application/vnd.ms-powerpoint', 'application/vnd.ms-excel', 'text/plain',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'];
    }
    match /materiais/{cursoId}/{arquivo} {
      allow read: if true;
      allow create: if resource == null && fEditor() && request.resource.size < 40 * 1024 * 1024 && fPermitido();
      allow update, delete: if false;
    }
    match /capas/{arquivo} {
      allow read: if true;
      allow create: if resource == null && fEditor() && request.resource.size < 3 * 1024 * 1024 && fImagem();
      allow update, delete: if false;
    }

    // Prova online: foto de confirmação do aluno no início e na entrega (só quando a prova pede fotos).
    // O próprio aluno envia (pela matrícula "m-<id>" ou pela conta antiga); vê o professor da prova, a gestão da escola e o admin.
    // As fotos são apagadas no fim do ano letivo (função limparFotosProvas).
    function provaOnline(p) { return firestore.get(/databases/(default)/documents/provas_online/$(p)).data; }
    function souAlunoDaFoto(chave) {
      return request.auth != null && (chave == request.auth.uid
        || (request.auth.token.get("aluno_id", "") != "" && chave == "m-" + request.auth.token.aluno_id));
    }
    match /provas_online/{p}/fotos/{chave}/{momento} {
      allow create, update: if souAlunoDaFoto(chave) && momento in ["inicio.jpg", "entrega.jpg"]
        && provaOnline(p).get("fotos", false) == true && provaOnline(p).status == "agendada"
        && (chave in provaOnline(p).get("alunos_uids", []) || chave.replace("m-", "") in provaOnline(p).get("alunos_ids", []))
        && request.resource.size < 400 * 1024 && request.resource.contentType == "image/jpeg";
      allow read: if admin() || (request.auth != null && provaOnline(p).professor_uid == request.auth.uid)
        || (request.auth != null && eu().status == "ativo" && eu().perfil == "gestor"
            && provaOnline(p).get("escola_id", "-") in eu().get("escolas_ids", [eu().get("escola_id", "")]));
      allow delete: if false;
    }

    // qualquer outro caminho continua bloqueado
    // Acervo da NEWPC: professor licenciado e equipe da rede leem; aluno so Datas e Historias; so o administrador envia
    match /acervo/{botao}/{arquivo} {
      allow read: if admin() || (request.auth != null && eu().status == "ativo" && (
        (eu().perfil != "aluno" && (licenciado() || (eu().perfil in ["secretaria", "gestor"] && eu().get("municipio_id", "") != "")))
        || (eu().perfil == "aluno" && botao in ["datas", "historias"])));
      allow create, update: if admin() && request.resource.size < 100 * 1024 * 1024;
      allow delete: if admin();
    }
    // Acervo da rede: so quem e do municipio le; so a Secretaria dele (ou o administrador) envia e apaga
    match /acervo-rede/{mun}/{arquivo} {
      allow read: if admin() || (request.auth != null && eu().status == "ativo" && eu().perfil != "aluno" && eu().get("municipio_id", "") == mun);
      allow create: if (admin() || (request.auth != null && eu().status == "ativo" && eu().perfil == "secretaria" && eu().get("municipio_id", "") == mun))
        && request.resource.size < 100 * 1024 * 1024;
      allow delete: if admin() || (request.auth != null && eu().status == "ativo" && eu().perfil == "secretaria" && eu().get("municipio_id", "") == mun);
    }

    match /{tudo=**} { allow read, write: if false; }
  }
}
