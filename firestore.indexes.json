{
  "indexes": [
    {
      "//": "Catálogo do professor: filtra por status e ordena por ordem. Firestore exige índice composto quando o filtro e a ordenação são de campos diferentes. Sem isto, a Academia abre com erro no primeiro acesso.",
      "collectionGroup": "cursos",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "ordem",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Mesma coisa para as trilhas.",
      "collectionGroup": "trilhas",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "ordem",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Usado pela Function ao verificar se o professor já tem certificado daquele curso.",
      "collectionGroup": "certificados",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "uid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "cursoId",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Lista de certificados do professor, do mais recente para o mais antigo.",
      "collectionGroup": "certificados",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "uid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "emitidoEmISO",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Usado por sortearProva para achar a prova que o professor já abriu e ainda não respondeu. Sem este índice a avaliação sorteia uma prova nova a cada recarga da página, o que abriria caminho para ir vendo o banco de questões aos poucos.",
      "collectionGroup": "provas",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "cursoId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "respondida",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "criadaEm",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "Resumo diário: alunos novos nas últimas 24 horas.",
      "collectionGroup": "usuarios",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "perfil",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "criado_em",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "collectionGroup": "acessos_dia",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "municipio",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "dia",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Prova online: a função de 5 em 5 minutos entrega as tentativas com prazo vencido.",
      "collectionGroup": "po_tentativas",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "prazo",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Prova online: encerra as provas que passaram do horário.",
      "collectionGroup": "provas_online",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "fecha_em",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Ficha do Servidor: o gestor lista a equipe das escolas dele (município + escolas da lotação).",
      "collectionGroup": "servidores",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "municipio_id",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "escolas_ids",
          "arrayConfig": "CONTAINS"
        }
      ]
    },
    {
      "//": "Histórico de alterações das notas: por turma, do mais recente para o mais antigo.",
      "collectionGroup": "notas_historico",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "escola_id",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "turma_id",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "em",
          "order": "DESCENDING"
        }
      ]
    }
  ],
