rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- quem e quem ----------
    function logado() { return request.auth != null; }
    function temCadastro() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function eu() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function admin() { return temCadastro() && eu().perfil == "admin" && eu().status == "ativo"; }

    // ---------- licenca ----------
    function tipoLic() { return eu().get("licenca_tipo", "institucional"); }
    function meuMuni() { return get(/databases/$(database)/documents/municipios/$(eu().municipio_id)).data; }
    // contrato do municipio sem data de fim = sem vencimento
    function contratoOk() { return meuMuni().get("vigencia_fim_ts", null) == null || meuMuni().vigencia_fim_ts > request.time; }
    // professor da rede atendida: vinculado a escola e contrato vigente
    function vinculado() {
      return temCadastro() && eu().status == "ativo" && (eu().perfil == "admin" ||
        (eu().perfil == "professor" && tipoLic() == "institucional" && eu().get("escola_id", null) != null && contratoOk()));
    }
    // qualquer licenca valida (institucional, avulsa, teste ou cortesia)
    function licenciado() {
      return vinculado() || (temCadastro() && eu().status == "ativo" && eu().perfil == "professor"
        && tipoLic() != "institucional" && eu().get("licenca_fim", null) != null && eu().licenca_fim > request.time);
    }
    function professor() { return vinculado(); }
    // escolas em que o professor da aula (cadastros antigos so tem escola_id)
    function minhasEscolas() { return eu().get("escolas_ids", [eu().get("escola_id", "")]); }

    // e-mail verificado (conta Google) que foi importado pelo administrador
    function meuEmail() { return request.auth.token.email.lower(); }
    function emailVerificado() { return logado() && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function temPreCadastro() { return emailVerificado() && exists(/databases/$(database)/documents/pre_cadastros/$(meuEmail())); }
    function pre() { return get(/databases/$(database)/documents/pre_cadastros/$(meuEmail())).data; }

    function novo() { return request.resource.data; }

    // ---------- aluno ----------
    // e-mail do token (Google), mesmo sem verificacao: usado para BLOQUEAR teste de professor em dominio de aluno
    function temEmail() { return logado() && request.auth.token.get("email", "") is string && request.auth.token.get("email", "").matches("^[^@]+@[^@]+$"); }
    function meuDominio() { return request.auth.token.email.lower().split("@")[1]; }
    function dominioDeAluno() { return temEmail() && exists(/databases/$(database)/documents/dominios_aluno/$(meuDominio())); }
    function domAluno() { return get(/databases/$(database)/documents/dominios_aluno/$(meuDominio())).data; }
    function camposAluno() {
      return novo().keys().hasOnly(["uid", "nome", "email", "perfil", "status", "licenca_tipo", "municipio_id", "municipio_nome",
        "escola_id", "escola_nome", "turma_nome", "origem", "criado_em", "criado_por", "atualizado_em", "atualizado_por"]);
    }
    // aluno da rede: so enxerga os modulos liberados para alunos no plano do municipio (lista vazia = todos os de aluno)
    function aluno() { return ativo() && eu().perfil == "aluno" && eu().get("municipio_id", null) != null && contratoOk(); }
    function alunoPode(m) { return aluno() && (meuMuni().get("modulos_aluno", []).size() == 0 || m in meuMuni().get("modulos_aluno", [])); }
    function naoAluno() { return ativo() && eu().perfil != "aluno"; }
    // escolas escolhidas pelo proprio professor: 1 a 5, todas do municipio dele
    function escolaDoMeuMuni(lista, i) {
      return lista.size() <= i || get(/databases/$(database)/documents/escolas/$(lista[i])).data.municipio_id == resource.data.municipio_id;
    }
    function escolasValidas() {
      let l = request.resource.data.escolas_ids;
      return resource.data.get("licenca_tipo", "institucional") == "institucional"
        && resource.data.get("municipio_id", null) != null
        && l.size() >= 1 && l.size() <= 5 && request.resource.data.escola_id == l[0]
        && request.resource.data.vinculo_alterado_por == request.auth.uid
        && escolaDoMeuMuni(l, 0) && escolaDoMeuMuni(l, 1) && escolaDoMeuMuni(l, 2) && escolaDoMeuMuni(l, 3) && escolaDoMeuMuni(l, 4);
    }
    function semVinculoDeRede() {
      return novo().escola_id == null && novo().municipio_id == null
        && novo().turmas_ids.size() == 0 && novo().escolas_ids.size() == 0;
    }

    // municipio: nome, plano e vigencia (lido por quem tem cadastro, para saber a licenca)
    match /municipios/{id} { allow read: if temCadastro(); allow write: if admin(); }
    // professor ve as escolas do proprio municipio (para escolher onde da aula)
    match /escolas/{id} {
      allow read: if admin() || (temCadastro() && resource.data.municipio_id == eu().get("municipio_id", "-"));
      allow write: if admin();
    }
    // turmas: o professor ve as das suas escolas e cria/edita as proprias
    match /turmas/{id} {
      allow read: if admin() || (vinculado() && resource.data.escola_id in minhasEscolas()) || entradaEscola(resource.data.escola_id);
      allow create: if admin() || (vinculado() && novo().criado_por == request.auth.uid
        && novo().escola_id in minhasEscolas() && novo().municipio_id == eu().municipio_id);
      allow update: if admin() || (vinculado() && resource.data.get("criado_por", "") == request.auth.uid
        && novo().criado_por == request.auth.uid && novo().escola_id in minhasEscolas())
        // grade da turma (qual professor dá qual disciplina): a Direção e a Secretaria da escola, só esses campos
        || (equipeEscola(resource.data.escola_id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["grade", "grade_chaves", "grade_em", "grade_por", "grade_por_nome"])
          && novo().grade is list && novo().grade.size() <= 30 && novo().get("grade_chaves", []) is list && novo().get("grade_chaves", []).size() <= 30);
      allow delete: if admin();
    }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || admin());
      // liberações exclusivas (modulos_extra, recursos_extra) só o administrador grava: ninguém nasce com elas
      allow create: if logado() && request.auth.uid == uid && !novo().keys().hasAny(["modulos_extra", "recursos_extra"]) && (
        // 1) autocadastro: professor ganha 7 dias de teste, sem vinculo com rede
        ( novo().perfil == "professor" && novo().status == "ativo"
          && novo().licenca_tipo == "teste"
          && novo().licenca_fim is timestamp
          && novo().licenca_fim < request.time + duration.value(8, "d")
          && semVinculoDeRede() && !dominioDeAluno() )
        ||
        // 2) legado: nasce "pendente", sem vinculo
        ( novo().perfil == "professor" && novo().status == "pendente" && semVinculoDeRede() && !dominioDeAluno() )
        ||
        // 3) professor importado: nasce aprovado, com exatamente o vinculo do pre-cadastro
        ( temPreCadastro()
          && pre().perfil == "professor" && pre().status == "ativo"
          && novo().perfil == "professor" && novo().status == "ativo"
          && novo().get("licenca_tipo", "institucional") == "institucional"
          && novo().email == meuEmail()
          && novo().municipio_id == pre().municipio_id
          && novo().escola_id == pre().escola_id
          && novo().escolas_ids == pre().escolas_ids
          && novo().turmas_ids == pre().turmas_ids )
        ||
        // 4) aluno da rede pelo dominio do e-mail (conta Google da escola): nasce ativo, so com o municipio do dominio
        ( emailVerificado() && dominioDeAluno() && domAluno().get("ativo", true) == true
          && novo().perfil == "aluno" && novo().status == "ativo" && novo().email == meuEmail()
          && novo().municipio_id == domAluno().municipio_id && novo().get("escola_id", null) == null
          && novo().get("licenca_tipo", "institucional") == "institucional" && camposAluno() )
        ||
        // 5) aluno importado pela rede (lista com e-mail)
        ( temPreCadastro() && pre().perfil == "aluno" && pre().status == "ativo"
          && novo().perfil == "aluno" && novo().status == "ativo" && novo().email == meuEmail()
          && novo().municipio_id == pre().municipio_id && novo().get("escola_id", null) == pre().get("escola_id", null)
          && novo().get("licenca_tipo", "institucional") == "institucional" && camposAluno() )
        ||
        // 6) equipe de apoio convidada pelo gestor (portaria, secretaria escolar): exatamente o vinculo do convite
        ( temPreCadastro() && perfilApoio(pre().perfil) && pre().status == "ativo"
          && novo().perfil == pre().perfil && novo().status == "ativo" && novo().email == meuEmail()
          && novo().get("licenca_tipo", "institucional") == "institucional"
          && novo().municipio_id == pre().municipio_id && novo().escola_id == pre().escola_id
          && novo().escolas_ids == pre().escolas_ids && novo().get("turmas_ids", []) == [] )
        ||
        // 7) gestor da escola e secretaria de educacao importados pelo administrador (so ele grava esses pre-cadastros)
        ( temPreCadastro() && pre().perfil in ["gestor", "secretaria"] && pre().status == "ativo"
          && novo().perfil == pre().perfil && novo().status == "ativo" && novo().email == meuEmail()
          && novo().get("licenca_tipo", "institucional") == "institucional"
          && novo().municipio_id == pre().municipio_id && novo().get("escola_id", null) == pre().get("escola_id", null)
          && novo().get("escolas_ids", []) == pre().get("escolas_ids", []) && novo().get("turmas_ids", []) == [] )
      );
      // o gestor ve e pausa (ativo/inativo) a equipe de apoio da escola dele
      allow read: if resource != null && perfilApoio(resource.data.get("perfil", "")) && gestorDaEscola(resource.data.get("escola_id", "-"));
      allow update: if perfilApoio(resource.data.get("perfil", "")) && gestorDaEscola(resource.data.get("escola_id", "-"))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "atualizado_em", "atualizado_por"])
        && novo().status in ["ativo", "inativo"];
      // o proprio usuario altera dados pessoais, suas escolas (so do proprio municipio, ate 5) e sua lista de turmas;
      // licenca, municipio, perfil e situacao so o administrador
      allow update: if admin() || (logado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ["nome", "whatsapp", "funcao", "escola_texto", "escola_inep", "etapas", "ultimo_acesso", "atualizado_em", "atualizado_por",
              "escolas_ids", "escolas_nomes", "escola_id", "turmas_ids", "vinculo_alterado_em", "vinculo_alterado_por"])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["escolas_ids", "escola_id"]) || (resource.data.perfil == "professor" && escolasValidas())));
      allow delete: if admin();
    }

    // trabalhos do professor (ex.: aulas da Lousa); o conteudo fica no Storage
    match /usuarios/{uid}/trabalhos/{id} {
      allow read, delete: if logado() && (request.auth.uid == uid || admin());
      allow create, update: if logado() && request.auth.uid == uid && licenciado();
    }

    // Minhas provas (Gerador de Provas): fichas e pastas do proprio professor; o conteudo fica no Storage
    match /usuarios/{uid}/provas/{id} {
      allow read, delete: if logado() && (request.auth.uid == uid || admin());
      allow create, update: if logado() && request.auth.uid == uid && licenciado();
    }
    // Aplicativos Uteis: configuracoes salvas da Folha Magica (so o dono)
    match /usuarios/{uid}/folhas/{id} {
      allow read, delete: if logado() && (request.auth.uid == uid || admin());
      allow create, update: if logado() && request.auth.uid == uid && (licenciado() || eu().perfil in ["gestor", "secretaria"])
        && novo().keys().hasOnly(["nome", "tipo", "cfg", "criado_em", "atualizado_em"])
        && novo().nome is string && novo().nome.size() <= 60 && novo().cfg is map;
    }
    // Turma na Lousa: sorteio, grupos, mapa da sala e placar de cada turma (so o dono)
    match /usuarios/{uid}/turma_lousa/{id} {
      allow read, delete: if logado() && (request.auth.uid == uid || admin());
      allow create, update: if logado() && request.auth.uid == uid && (licenciado() || eu().perfil in ["gestor", "secretaria"])
        && novo().keys().hasOnly(["turma_nome", "nomes", "sorteados", "ausentes", "grupos", "mapa", "placar", "atualizado_em"])
        && novo().nomes is list && novo().nomes.size() <= 80 && novo().sorteados is list && novo().sorteados.size() <= 120
        && novo().ausentes is map && novo().grupos is map && novo().mapa is map && novo().placar is map;
    }
    // Teleprompter: roteiros salvos na conta (so o dono), ate 200 mil caracteres
    match /usuarios/{uid}/roteiros/{id} {
      allow read, delete: if logado() && (request.auth.uid == uid || admin());
      allow create, update: if logado() && request.auth.uid == uid && (licenciado() || eu().perfil in ["gestor", "secretaria"])
        && novo().keys().hasOnly(["titulo", "texto", "settings", "markers", "locked", "cursor", "elapsed", "palavras", "criado_em", "atualizado_em"])
        && novo().titulo is string && novo().titulo.size() <= 100 && novo().texto is string && novo().texto.size() <= 200000
        && novo().markers is list && novo().markers.size() <= 100;
    }
    // Minha agenda (lembretes da escola e pessoais): só o próprio dono lê e grava, nem o administrador vê
    match /usuarios/{uid}/lembretes/{id} {
      allow read, delete: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid && ativo() && eu().perfil != "aluno"
        && novo().keys().hasOnly(["titulo", "tipo", "data", "hora", "repetir", "ate", "avisar", "antes_min", "notas", "feitos", "tz_min",
          "proxima", "proximo_aviso", "avisado", "criado_em", "atualizado_em"])
        && novo().titulo is string && novo().titulo.size() > 0 && novo().titulo.size() <= 120
        && novo().tipo in ["escola", "pessoal"] && dataOk(novo().data)
        && novo().hora is string && (novo().hora == "" || novo().hora.matches("^[0-2][0-9]:[0-5][0-9]$"))
        && novo().repetir in ["nao", "semanal", "mensal"] && (novo().ate == "" || dataOk(novo().ate))
        && novo().avisar in ["nao", "resumo", "hora"] && novo().antes_min in [0, 15, 60, 1440]
        && novo().notas is string && novo().notas.size() <= 500
        && novo().feitos is list && novo().feitos.size() <= 400
        && novo().tz_min is int && novo().tz_min >= -840 && novo().tz_min <= 720
        && (novo().proxima == null || dataOk(novo().proxima))
        && (novo().proximo_aviso == null || novo().proximo_aviso is timestamp);
    }
    match /usuarios/{uid}/pastas_provas/{id} {
      allow read, delete: if logado() && (request.auth.uid == uid || admin());
      allow create, update: if logado() && request.auth.uid == uid && licenciado();
    }

    // Central de Relatorios: o autor edita; a gestao da escola confere (aprova/devolve); a secretaria municipal acompanha
    function ativo() { return temCadastro() && eu().status == "ativo"; }
    function gestorDaEscola(esc) { return ativo() && eu().perfil == "gestor" && esc in minhasEscolas(); }
    // equipe de apoio da escola, convidada pelo gestor: secretaria escolar (familias, busca ativa, portaria) e portaria (so a entrada)
    function secEscolar(esc) { return ativo() && eu().perfil == "secretaria_escolar" && esc in minhasEscolas(); }
    function portariaDaEscola(esc) { return ativo() && eu().perfil == "portaria" && esc in minhasEscolas(); }
    function equipeEscola(esc) { return gestorDaEscola(esc) || secEscolar(esc); }
    function entradaEscola(esc) { return equipeEscola(esc) || portariaDaEscola(esc); }
    function perfilApoio(p) { return p in ["portaria", "secretaria_escolar"]; }
    function secretariaDoMuni(m) { return ativo() && eu().perfil == "secretaria" && eu().get("municipio_id", "") == m; }
    match /relatorios/{id} {
      allow read: if admin() || (logado() && resource.data.autor_uid == request.auth.uid)
        || gestorDaEscola(resource.data.escola_id) || secretariaDoMuni(resource.data.municipio_id);
      allow create: if logado() && novo().autor_uid == request.auth.uid && ativo()
        && (licenciado() || eu().perfil in ["gestor", "secretaria"])
        && (novo().escola_id == "" || novo().escola_id in minhasEscolas() || eu().perfil == "secretaria")
        && novo().status in ["rascunho", "enviado"];
      allow update: if admin()
        || (logado() && resource.data.autor_uid == request.auth.uid && resource.data.status != "aprovado"
            && novo().autor_uid == request.auth.uid && novo().status in ["rascunho", "enviado", "devolvido"]
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["revisado_por", "revisado_em"]))
        || (gestorDaEscola(resource.data.escola_id) && novo().status in ["aprovado", "devolvido"]
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "comentario", "revisado_por", "revisado_nome", "revisado_em"]));
      allow delete: if admin() || (logado() && resource.data.autor_uid == request.auth.uid && resource.data.status != "aprovado");
    }

    // ---------- Teleprompter: controle pelo celular ----------
    // O computador (logado) cria a sessao com uma chave aleatoria de 24 caracteres e mostra no QR code.
    // O celular nao faz login: le o estado da leitura e manda comandos so para a sessao daquela chave.
    function acoesTele() { return ["alternar", "iniciar", "pausar", "proximo", "anterior", "inicio", "mais_rapido", "mais_lento", "maior", "menor"]; }
    match /tele_sessoes/{chave} {
      allow get: if chave.matches("^[A-Za-z0-9]{24}$");
      allow create: if logado() && chave.matches("^[A-Za-z0-9]{24}$") && novo().dono == request.auth.uid
        && (licenciado() || (ativo() && eu().perfil in ["gestor", "secretaria"]));
      allow update: if logado() && resource.data.dono == request.auth.uid && novo().dono == request.auth.uid;
      allow delete: if logado() && resource.data.dono == request.auth.uid;
      match /cmd/{id} {
        allow create: if novo().keys().hasOnly(["acao", "em"]) && novo().acao in acoesTele() && novo().em == request.time
          && get(/databases/$(database)/documents/tele_sessoes/$(chave)).data.ativo == true;
        allow read, delete: if logado() && get(/databases/$(database)/documents/tele_sessoes/$(chave)).data.dono == request.auth.uid;
      }
    }

    // ---------- Portal do Educador TV ----------
    // A TV nao tem login: le a propria tela, as playlists e o canal de comunicados pelo ID (aleatorio, impossivel de adivinhar).
    // Listar e alterar e so para a equipe da escola (professor licenciado, gestor), a secretaria do municipio e o administrador.
    function muniDaEscola(esc) { return get(/databases/$(database)/documents/escolas/$(esc)).data.municipio_id; }
    function tvEquipeEscola(esc) {
      return admin() || (licenciado() && esc in minhasEscolas()) || gestorDaEscola(esc)
        || (ativo() && eu().perfil == "secretaria" && muniDaEscola(esc) == eu().get("municipio_id", "-"));
    }
    function tvLeitor(esc, m) {
      return admin() || (ativo() && eu().perfil != "aluno" && (esc in minhasEscolas() || (eu().perfil == "secretaria" && m == eu().get("municipio_id", "-"))));
    }
    match /tv_pareamentos/{cod} {
      allow create: if cod.matches("^[A-HJ-NP-Z2-9]{6}$") && novo().keys().hasOnly(["chave", "criado_em", "orientacao", "resolucao"])
        && novo().chave is string && novo().chave.matches("^[A-Za-z0-9]{20}$") && novo().criado_em == request.time
        && novo().get("resolucao", "") is string && novo().get("resolucao", "").size() < 20;
      allow get, delete: if ativo() && eu().perfil != "aluno";
    }
    match /tv_telas/{chave} {
      allow get: if true;
      allow list: if tvLeitor(resource.data.escola_id, resource.data.municipio_id);
      allow create: if chave.matches("^[A-Za-z0-9]{20}$") && tvEquipeEscola(novo().escola_id) && novo().municipio_id == muniDaEscola(novo().escola_id);
      allow update: if (tvEquipeEscola(resource.data.escola_id) && novo().escola_id == resource.data.escola_id && novo().municipio_id == resource.data.municipio_id)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visto_em", "resolucao", "aparelho"]) && novo().visto_em == request.time
            && novo().resolucao is string && novo().resolucao.size() < 20 && novo().aparelho is string && novo().aparelho.size() < 20);
      allow delete: if tvEquipeEscola(resource.data.escola_id);
    }
    match /tv_playlists/{id} {
      allow get: if true;
      allow list: if tvLeitor(resource.data.escola_id, resource.data.municipio_id);
      allow create: if tvEquipeEscola(novo().escola_id) && novo().municipio_id == muniDaEscola(novo().escola_id) && novo().itens is list && novo().itens.size() <= 80;
      allow update: if tvEquipeEscola(resource.data.escola_id) && novo().escola_id == resource.data.escola_id && novo().municipio_id == resource.data.municipio_id
        && novo().itens is list && novo().itens.size() <= 80;
      allow delete: if tvEquipeEscola(resource.data.escola_id);
    }
    // ---------- Notas e Medias ----------
    // regra de calculo do municipio (bimestres, pesos, media minima, recuperacao, frequencia): a secretaria define, a rede le
    match /notas_regras/{m} {
      allow get: if admin() || (ativo() && eu().perfil != "aluno" && eu().get("municipio_id", "-") == m);
      allow create, update: if (admin() || secretariaDoMuni(m))
        && novo().keys().hasOnly(["periodos", "pesos", "media_minima", "nota_max", "arredondamento", "composicao", "rec_periodo", "rec_final", "sem_retencao",
          "peso_media", "peso_exame", "media_final_minima", "freq_minima", "atualizado_em", "atualizado_por"])
        && novo().periodos in [2, 3, 4] && novo().pesos is list && novo().pesos.size() == novo().periodos
        && novo().nota_max in [10, 100] && novo().media_minima is number && novo().media_minima > 0 && novo().media_minima <= novo().nota_max
        && novo().arredondamento in ["decimo", "meio_cima", "inteiro"] && novo().composicao in ["media", "soma"]
        && novo().rec_periodo in ["maior", "media", "nao"] && novo().rec_final is bool && novo().freq_minima is number && novo().freq_minima <= 100
        && novo().get("sem_retencao", []) is list && novo().get("sem_retencao", []).size() <= 9;
    }
    // planilha de notas do professor: uma por turma, disciplina e ano; o ID comeca com o uid do dono
    // ---------- Calendário e Dias Letivos ----------
    // cal_rede/{municipio}_{ano}: base da rede, feita pela secretaria. cal_escola/{escola}_{ano}: ajustes da escola (gestor ou secretaria).
    function dataOk(v) { return v is string && v.matches("^20[2-9][0-9]-[01][0-9]-[0-3][0-9]$"); }
    function calEventosOk() { return novo().eventos is list && novo().eventos.size() <= 200; }
    match /cal_rede/{id} {
      allow get: if admin() || (naoAluno() && (resource == null || resource.data.municipio_id == eu().get("municipio_id", "-")));
      allow list: if admin() || (naoAluno() && resource.data.municipio_id == eu().get("municipio_id", "-"));
      allow create, update: if (admin() || secretariaDoMuni(novo().municipio_id))
        && novo().keys().hasOnly(["municipio_id", "ano", "inicio", "fim", "dias_semana", "horas_dia", "meta_dias", "meta_horas", "periodos",
          "facultativos_letivos", "eventos", "token", "atualizado_em", "atualizado_por"])
        && novo().ano is int && id == novo().municipio_id + "_" + string(novo().ano)
        && (resource == null || resource.data.municipio_id == novo().municipio_id)
        && dataOk(novo().inicio) && dataOk(novo().fim) && novo().inicio < novo().fim
        && novo().dias_semana is list && novo().dias_semana.size() <= 7
        && novo().horas_dia is number && novo().horas_dia > 0 && novo().horas_dia <= 12
        && novo().periodos is list && novo().periodos.size() <= 4
        && novo().facultativos_letivos is list && novo().facultativos_letivos.size() <= 20
        && calEventosOk() && novo().token is string && novo().token.matches("^[A-Za-z0-9]{20}$");
      allow delete: if admin();
    }
    match /cal_escola/{id} {
      allow get: if admin() || (naoAluno() && (resource == null || resource.data.municipio_id == eu().get("municipio_id", "-")
        || resource.data.escola_id in minhasEscolas()));
      allow list: if admin() || secretariaDoMuni(resource.data.municipio_id) || (naoAluno() && resource.data.escola_id in minhasEscolas());
      allow create, update: if (admin() || secretariaDoMuni(novo().municipio_id) || gestorDaEscola(novo().escola_id))
        && novo().keys().hasOnly(["escola_id", "municipio_id", "ano", "horas_dia", "eventos", "atualizado_em", "atualizado_por"])
        && novo().ano is int && id == novo().escola_id + "_" + string(novo().ano)
        && (resource == null || (resource.data.escola_id == novo().escola_id && resource.data.municipio_id == novo().municipio_id))
        && muniDaEscola(novo().escola_id) == novo().municipio_id
        && (novo().horas_dia == null || (novo().horas_dia is number && novo().horas_dia > 0 && novo().horas_dia <= 12))
        && calEventosOk();
      allow delete: if admin();
    }

    match /notas_planilhas/{id} {
      allow read: if logado() && (resource.data.professor_uid == request.auth.uid || admin()
        || gestorDaEscola(resource.data.escola_id) || secretariaDoMuni(resource.data.municipio_id)
        // Secretaria da escola: só leitura, para emitir o boletim escolar
        || secEscolar(resource.data.escola_id));
      allow create, update: if logado() && novo().professor_uid == request.auth.uid && id.matches("^" + request.auth.uid + "_.+")
        && (licenciado() || eu().perfil in ["gestor", "secretaria"])
        && (resource == null || resource.data.professor_uid == request.auth.uid)
        && novo().keys().hasOnly(["professor_uid", "professor_nome", "escola_id", "municipio_id", "turma_id", "turma_nome", "disciplina", "ano_letivo",
          "avaliacoes", "notas", "faltas", "aulas", "exame", "conselho", "atualizado_em"])
        && novo().avaliacoes is list && novo().avaliacoes.size() <= 80 && novo().notas is map && novo().notas.size() <= 120
        && novo().disciplina is string && novo().disciplina.size() <= 60;
      allow delete: if logado() && resource.data.professor_uid == request.auth.uid;
    }

    // ---------- Frequencia digital ----------
    // chamada: um professor, uma turma, um dia, uma disciplina; ID = {uid}_{turma}_{dia}_{disciplina}
    // escola e municipio precisam ser os da turma; o resumo por aluno (freq_resumo) so a funcao escreve
    function turmaDoc(t) { return get(/databases/$(database)/documents/turmas/$(t)).data; }
    // substituição (professor faltou): ID = {escola}_{dia}_{turma}_{disciplina}; quem foi nomeado faz a chamada daquela aula naquele dia
    function subPath(c) { return /databases/$(database)/documents/substituicoes/$(c.escola_id + "_" + c.dia + "_" + c.turma_id + "_" + c.disc_id); }
    function substitutoDe(c) { return exists(subPath(c)) && get(subPath(c)).data.substituto_uid == request.auth.uid; }
    // diretor ou coordenador com aula fixa: está na grade da turma naquela disciplina (turmas.grade_chaves = ["uid|disciplina"])
    function naGrade(c) { return (request.auth.uid + "|" + c.disc_id) in turmaDoc(c.turma_id).get("grade_chaves", []); }
    match /freq_chamadas/{id} {
      // a titular também lê a chamada que o substituto fez na turma dela (histórico e diário do mês)
      allow read: if logado() && (resource == null || resource.data.professor_uid == request.auth.uid || resource.data.get("titular_uid", "") == request.auth.uid
        || admin() || equipeEscola(resource.data.escola_id));
      allow create, update: if (vinculado() || (ativo() && eu().perfil == "gestor" && (substitutoDe(novo()) || naGrade(novo())))) && novo().professor_uid == request.auth.uid
        && id == request.auth.uid + "_" + novo().turma_id + "_" + novo().dia + "_" + novo().disc_id
        && (resource == null || (resource.data.professor_uid == request.auth.uid && resource.data.turma_id == novo().turma_id && resource.data.dia == novo().dia))
        && novo().keys().hasOnly(["professor_uid", "professor_nome", "escola_id", "municipio_id", "turma_id", "turma_nome", "disciplina", "disc_id",
          "dia", "ano", "aulas", "lista", "nomes", "faltas", "just", "conteudo", "atualizado_em", "titular_uid", "titular_nome"])
        && (!("titular_uid" in novo()) || (substitutoDe(novo()) && get(subPath(novo())).data.titular_uid == novo().titular_uid))
        && (admin() || (turmaDoc(novo().turma_id).escola_id == novo().escola_id && novo().escola_id in minhasEscolas()
          && turmaDoc(novo().turma_id).municipio_id == novo().municipio_id))
        && dataOk(novo().dia) && novo().ano is int && int(novo().dia.split("-")[0]) == novo().ano
        && novo().disc_id is string && novo().disc_id.matches("^[a-z0-9-]{1,40}$") && texto(novo().disciplina, 60)
        && novo().aulas is int && novo().aulas >= 1 && novo().aulas <= 6
        && novo().lista is list && novo().lista.size() <= 80 && novo().nomes is map && novo().nomes.size() <= 80
        && novo().faltas is map && novo().faltas.size() <= 80 && novo().just is map && novo().just.size() <= 80
        && texto(novo().get("conteudo", ""), 600) && texto(novo().turma_nome, 80) && texto(novo().professor_nome, 80);
      allow delete: if logado() && (resource.data.professor_uid == request.auth.uid || admin());
    }
    // notas digitadas pela escola (diário de papel): a nota de cada período, por disciplina; só a Direção e a Secretaria da escola
    match /notas_escola/{id} {
      allow read: if admin() || equipeEscola(resource.data.escola_id) || secretariaDoMuni(resource.data.municipio_id);
      allow create, update: if (admin() || equipeEscola(novo().escola_id))
        && (resource == null || admin() || equipeEscola(resource.data.escola_id))
        && id == novo().escola_id + "_" + novo().turma_id + "_" + novo().disc_id + "_" + string(novo().ano_letivo)
        && novo().keys().hasOnly(["escola_id", "municipio_id", "turma_id", "turma_nome", "disciplina", "disc_id", "ano_letivo", "notas", "faltas", "aulas", "exame",
          "atualizado_em", "atualizado_por", "atualizado_por_nome"])
        && novo().ano_letivo is int && novo().disc_id is string && novo().disc_id.matches("^[a-z0-9-]{1,40}$") && texto(novo().disciplina, 60)
        && novo().notas is map && novo().notas.size() <= 80 && novo().faltas is map && novo().faltas.size() <= 80 && novo().aulas is map && novo().aulas.size() <= 4 && novo().get("exame", {}) is map && novo().get("exame", {}).size() <= 80
        && (admin() || turmaDoc(novo().turma_id).escola_id == novo().escola_id);
      allow delete: if admin() || equipeEscola(resource.data.escola_id);
    }
    // fechamento dos períodos e a cópia oficial das notas fechadas: só as funções escrevem
    match /fechamentos/{id} {
      allow read: if admin() || equipeEscola(resource.data.escola_id) || secretariaDoMuni(resource.data.municipio_id)
        || (vinculado() && resource.data.escola_id in minhasEscolas());
      allow write: if false;
    }
    match /notas_fechadas/{id} {
      allow read: if admin() || equipeEscola(resource.data.escola_id) || secretariaDoMuni(resource.data.municipio_id);
      allow write: if false;
    }
    // histórico de alterações das notas (a função registra a cada gravação)
    match /notas_historico/{id} {
      allow read: if admin() || equipeEscola(resource.data.escola_id) || secretariaDoMuni(resource.data.municipio_id);
      allow write: if false;
    }
    match /substituicoes/{id} {
      allow read: if admin() || equipeEscola(resource.data.escola_id) || secretariaDoMuni(resource.data.municipio_id)
        || resource.data.substituto_uid == request.auth.uid || resource.data.titular_uid == request.auth.uid;
      allow create, update: if (admin() || equipeEscola(novo().escola_id))
        && (resource == null || admin() || equipeEscola(resource.data.escola_id))
        && id == novo().escola_id + "_" + novo().dia + "_" + novo().turma_id + "_" + novo().disc_id
        && novo().keys().hasOnly(["escola_id", "escola_nome", "municipio_id", "dia", "turma_id", "turma_nome", "disciplina", "disc_id",
          "titular_uid", "titular_nome", "substituto_uid", "substituto_nome", "motivo", "lote", "criado_por", "criado_por_nome", "criado_em"])
        && dataOk(novo().dia) && novo().disc_id is string && novo().disc_id.matches("^[a-z0-9-]{1,40}$")
        && novo().substituto_uid is string && novo().titular_uid is string && novo().substituto_uid != novo().titular_uid
        && texto(novo().get("motivo", ""), 120)
        && (admin() || turmaDoc(novo().turma_id).escola_id == novo().escola_id);
      allow delete: if admin() || equipeEscola(resource.data.escola_id);
    }
    match /freq_resumo/{id} {
      allow read: if admin() || equipeEscola(resource.data.escola_id) || (vinculado() && resource.data.escola_id in minhasEscolas());
      allow write: if false;
    }

    // entradas pela portaria (carteirinha com QR): um documento por turma e dia; so a gestao da escola grava
    match /freq_entradas/{id} {
      allow read: if admin() || entradaEscola(resource.data.escola_id);
      allow create, update: if (admin() || entradaEscola(novo().escola_id))
        && id == novo().turma_id + "_" + novo().dia
        && (resource == null || (resource.data.escola_id == novo().escola_id && resource.data.turma_id == novo().turma_id && resource.data.dia == novo().dia))
        && novo().keys().hasOnly(["escola_id", "municipio_id", "turma_id", "turma_nome", "dia", "ano", "entradas", "nomes", "fotos", "atualizado_em"])
        && (resource == null || novo().get("fotos", null) == resource.data.get("fotos", null))
        && (admin() || (turmaDoc(novo().turma_id).escola_id == novo().escola_id && turmaDoc(novo().turma_id).municipio_id == novo().municipio_id))
        && dataOk(novo().dia) && novo().ano is int && int(novo().dia.split("-")[0]) == novo().ano
        && novo().entradas is map && novo().entradas.size() <= 80 && novo().nomes is map && novo().nomes.size() <= 80 && texto(novo().turma_nome, 80);
      allow delete: if admin();
    }
    // registro de quem abriu cada foto da entrada (auditoria da diretoria): so cria, nunca altera nem apaga
    match /portaria_vistas/{id} {
      allow read: if admin() || gestorDaEscola(resource.data.escola_id);
      allow create: if (admin() || gestorDaEscola(novo().escola_id))
        && novo().keys().hasOnly(["escola_id", "aluno_id", "aluno_nome", "dia", "foto", "por_uid", "por_nome", "em", "mes"])
        && novo().por_uid == request.auth.uid && novo().em == request.time
        && novo().escola_id is string && novo().aluno_id is string && novo().aluno_id.matches("^[A-Za-z0-9_-]{1,64}$")
        && dataOk(novo().dia) && novo().mes is string && novo().mes.matches("^20[0-9]{2}-[01][0-9]$")
        && novo().foto is string && novo().foto.size() <= 200 && novo().foto.matches("^portaria/" + novo().escola_id + "/" + novo().dia + "/" + novo().aluno_id + "_[0-9]{4}[.]jpg$")
        && texto(novo().aluno_nome, 80) && texto(novo().por_nome, 80);
      allow update, delete: if false;
    }

    // familia do aluno: contatos dos responsaveis (um documento por aluno, mesmo ID do aluno)
    // so a gestao da escola e o administrador; o professor nao ve telefone de familia (LGPD: so o necessario)
    function alunoDoc(a) { return get(/databases/$(database)/documents/alunos/$(a)).data; }
    match /alunos_familia/{id} {
      allow read: if admin() || (resource == null && ativo() && eu().perfil in ["gestor", "secretaria_escolar"]) || (resource != null && equipeEscola(resource.data.escola_id));
      allow create, update: if (admin() || equipeEscola(novo().escola_id))
        && id == novo().aluno_id && alunoDepois(id).escola_id == novo().escola_id
        && (resource == null || resource.data.escola_id == novo().escola_id)
        && novo().keys().hasOnly(["aluno_id", "aluno_nome", "escola_id", "municipio_id", "turma_id", "turma_nome", "responsaveis", "aceita_avisos", "obs", "origem", "atualizado_em", "atualizado_por", "atualizado_por_nome"])
        && novo().responsaveis is list && novo().responsaveis.size() <= 4 && novo().aceita_avisos is bool
        && texto(novo().get("obs", ""), 300) && texto(novo().aluno_nome, 80);
      allow delete: if admin() || gestorDaEscola(resource.data.escola_id);
    }

    // ---------- Ficha do Aluno ----------
    // documento, endereço, transporte, vida escolar, programas sociais e anexos: gestão e secretaria escolar (mesmo ID do aluno)
    function alunoDepois(a) { return getAfter(/databases/$(database)/documents/alunos/$(a)).data; }
    function fichaDaEscola(id) {
      return (admin() || equipeEscola(novo().escola_id))
        && id == novo().aluno_id && alunoDepois(id).escola_id == novo().escola_id
        && (resource == null || resource.data.escola_id == novo().escola_id)
        && texto(novo().aluno_nome, 80) && novo().atualizado_por == request.auth.uid && texto(novo().get("atualizado_por_nome", ""), 80);
    }
    function leFichaEscola() {
      return admin() || (resource == null && ativo() && eu().perfil in ["gestor", "secretaria_escolar"]) || (resource != null && equipeEscola(resource.data.escola_id));
    }
    match /alunos_ficha/{id} {
      allow read: if leFichaEscola();
      allow create, update: if fichaDaEscola(id)
        && novo().keys().hasOnly(["aluno_id", "aluno_nome", "escola_id", "municipio_id", "sexo", "naturalidade", "cpf", "nis", "sus", "certidao",
          "endereco", "transporte", "vida", "programas", "documentos", "obs", "saude_revisada", "origem", "atualizado_em", "atualizado_por", "atualizado_por_nome"])
        && novo().get("documentos", []) is list && novo().get("documentos", []).size() <= 30
        && novo().get("endereco", {}) is map && novo().get("transporte", {}) is map && novo().get("vida", {}) is map && novo().get("programas", {}) is map
        && texto(novo().get("cpf", ""), 14) && texto(novo().get("nis", ""), 14) && texto(novo().get("sus", ""), 18) && texto(novo().get("obs", ""), 600);
      allow delete: if admin() || gestorDaEscola(resource.data.escola_id);
    }
    // saúde e inclusão (dado sensível, LGPD art. 11): só gestão e secretaria escolar; o professor vê apenas os alertas no cadastro do aluno
    match /alunos_saude/{id} {
      allow read: if leFichaEscola();
      allow create, update: if fichaDaEscola(id)
        && novo().keys().hasOnly(["aluno_id", "aluno_nome", "escola_id", "municipio_id", "deficiencias", "laudo", "cid", "aee", "apoio",
          "acompanhamentos", "acomp_obs", "condicoes", "alergias", "medicacao", "restricao", "emergencia", "plano_saude", "obs", "ciencia",
          "origem", "atualizado_em", "atualizado_por", "atualizado_por_nome"])
        && novo().get("deficiencias", []) is list && novo().get("deficiencias", []).size() <= 12
        && novo().get("acompanhamentos", []) is list && novo().get("acompanhamentos", []).size() <= 12
        && novo().get("emergencia", {}) is map && novo().get("ciencia", {}) is map
        && texto(novo().get("cid", ""), 60) && texto(novo().get("condicoes", ""), 400) && texto(novo().get("alergias", ""), 300)
        && texto(novo().get("medicacao", ""), 300) && texto(novo().get("restricao", ""), 300) && texto(novo().get("obs", ""), 600) && texto(novo().get("acomp_obs", ""), 400);
      allow delete: if admin() || gestorDaEscola(resource.data.escola_id);
    }
    // autorizados a buscar o aluno (com foto) e restrições: a portaria consulta na saída; o professor não vê
    match /alunos_autorizados/{id} {
      allow read: if admin() || (resource == null && ativo() && eu().perfil in ["gestor", "secretaria_escolar", "portaria"]) || (resource != null && entradaEscola(resource.data.escola_id));
      allow create, update: if fichaDaEscola(id)
        && novo().keys().hasOnly(["aluno_id", "aluno_nome", "escola_id", "municipio_id", "turma_id", "turma_nome", "lista", "restricoes", "atualizado_em", "atualizado_por", "atualizado_por_nome"])
        && novo().lista is list && novo().lista.size() <= 6 && texto(novo().get("restricoes", ""), 400) && texto(novo().get("turma_nome", ""), 80);
      allow delete: if admin() || gestorDaEscola(resource.data.escola_id);
    }
    // ---------- Ficha do Servidor (professores, direção, coordenação, secretaria, apoio) ----------
    // um documento por e-mail: o próprio servidor preenche (autosserviço); a gestão da escola e a Secretaria de Educação conferem e validam
    function camposServidor() {
      return ["email", "nome", "nome_social", "foto", "nascimento", "cpf", "telefone", "matricula_func", "municipio_id", "escolas_ids", "cargo", "vinculo",
        "carga_horaria", "lotacao", "formacao", "cursos_portal", "documentos", "validacao", "origem", "atualizado_em", "atualizado_por", "atualizado_por_nome"];
    }
    function servidorOk(email) {
      return novo().keys().hasOnly(camposServidor()) && novo().email == email
        && novo().nome is string && novo().nome.size() >= 2 && novo().nome.size() <= 80
        && novo().municipio_id is string && novo().municipio_id.size() > 0
        && novo().escolas_ids is list && novo().escolas_ids.size() <= 10
        && novo().get("lotacao", []) is list && novo().get("lotacao", []).size() <= 10
        && novo().get("documentos", []) is list && novo().get("documentos", []).size() <= 20
        && novo().get("cursos_portal", []) is list && novo().get("cursos_portal", []).size() <= 60
        && novo().get("formacao", {}) is map && novo().get("validacao", {}) is map
        && (novo().get("foto", "") == "" || (novo().foto.matches("^servidores/[^/]+/foto-[A-Za-z0-9_-]{1,40}[.]jpg$") && novo().foto.split("/")[1] == email))
        && (novo().get("nascimento", "") == "" || novo().nascimento.matches("^(19|20)[0-9]{2}-[01][0-9]-[0-3][0-9]$"))
        && texto(novo().get("cpf", ""), 11) && texto(novo().get("matricula_func", ""), 30) && texto(novo().get("telefone", ""), 13)
        && novo().atualizado_por == request.auth.uid && texto(novo().get("atualizado_por_nome", ""), 80);
    }
    function proprioServidor(email) { return emailVerificado() && meuEmail() == email && ativo() && eu().perfil != "aluno"; }
    function gestorDoServidor(d) { return ativo() && eu().perfil == "gestor" && d.municipio_id == eu().get("municipio_id", "-") && d.escolas_ids.hasAny(minhasEscolas()); }
    function equipeDoServidor(d) { return admin() || secretariaDoMuni(d.municipio_id) || gestorDoServidor(d); }
    // o próprio servidor não se valida: toda alteração dele volta para "pendente"
    function semValidarASi() { return novo().get("validacao", {}).get("status", "pendente") == "pendente"; }
    match /servidores/{email} {
      allow read: if admin() || proprioServidor(email) || (resource == null && ativo() && eu().perfil in ["gestor", "secretaria"])
        || (resource != null && (secretariaDoMuni(resource.data.municipio_id) || gestorDoServidor(resource.data)));
      allow create: if servidorOk(email) && (equipeDoServidor(novo())
        || (proprioServidor(email) && novo().municipio_id == eu().get("municipio_id", "-") && semValidarASi()));
      allow update: if servidorOk(email) && novo().municipio_id == resource.data.municipio_id
        && (equipeDoServidor(resource.data) || (proprioServidor(email) && semValidarASi()));
      allow delete: if admin() || secretariaDoMuni(resource.data.municipio_id);
    }
    // senha provisória: o próprio usuário só vê que tem uma (e quando vence); só as funções gravam
    match /senhas_provisorias/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }
    // conferência do CPF na Receita (Serpro): só a função conferirCpfServidor grava; lê quem lê a ficha do servidor
    match /cpf_receita/{email} {
      allow read: if admin() || proprioServidor(email) || (resource != null && (secretariaDoMuni(resource.data.municipio_id) || gestorDoServidor(resource.data)));
      allow write: if false;
    }

    // quem abriu a saúde, um anexo ou imprimiu a ficha (auditoria da direção): só cria, nunca altera nem apaga
    match /alunos_acessos/{id} {
      allow read: if admin() || gestorDaEscola(resource.data.escola_id);
      allow create: if (admin() || equipeEscola(novo().escola_id))
        && novo().keys().hasOnly(["escola_id", "aluno_id", "aluno_nome", "secao", "detalhe", "por_uid", "por_nome", "em", "mes"])
        && novo().por_uid == request.auth.uid && novo().em == request.time
        && novo().secao in ["saude", "documento", "impressao", "exportacao"]
        && novo().aluno_id is string && novo().aluno_id.matches("^[A-Za-z0-9_*-]{1,64}$")
        && novo().mes is string && novo().mes.matches("^20[0-9]{2}-[01][0-9]$")
        && texto(novo().aluno_nome, 80) && texto(novo().get("detalhe", ""), 120) && texto(novo().por_nome, 80);
      allow update, delete: if false;
    }

    // avisos as familias: a escola liga cada tipo; o registro de envios so a funcao grava; comunicado criado pelo gestor
    match /avisos_config/{esc} {
      // a secretaria escolar ve o que esta ligado; so o gestor liga e desliga
      allow read: if admin() || equipeEscola(esc);
      allow write: if (admin() || gestorDaEscola(esc))
        && novo().keys().hasOnly(["falta_dia", "seguidos", "fora_sala", "chegada", "atualizado_em", "atualizado_por", "atualizado_por_nome"])
        && novo().falta_dia is bool && novo().seguidos is bool && novo().fora_sala is bool && novo().chegada is bool && texto(novo().get("atualizado_por_nome", ""), 80);
    }
    match /avisos_familia/{id} {
      allow read: if admin() || (resource != null && equipeEscola(resource.data.escola_id));
      allow write: if false;
    }
    match /avisos_contador/{dia} { allow read: if admin(); allow write: if false; }
    match /comunicados_familia/{id} {
      allow read: if admin() || (resource != null && equipeEscola(resource.data.escola_id));
      allow create: if (admin() || equipeEscola(novo().escola_id)) && novo().criado_por == request.auth.uid && novo().status == "pendente"
        && novo().keys().hasOnly(["escola_id", "escola_nome", "municipio_id", "titulo", "texto", "turmas", "status", "criado_em", "criado_por", "criado_por_nome"])
        && texto(novo().titulo, 120) && novo().titulo.size() >= 3 && texto(novo().texto, 3000) && novo().texto.size() >= 3
        && novo().turmas is list && novo().turmas.size() >= 1 && novo().turmas.size() <= 200 && texto(novo().get("criado_por_nome", ""), 80);
      allow update, delete: if false;
    }

    // ficha de busca ativa: um caso por aluno, escola e ano; so a gestao da escola (e o administrador)
    match /busca_ativa/{id} {
      allow read: if admin() || (resource == null && ativo() && eu().perfil in ["gestor", "secretaria_escolar"]) || (resource != null && equipeEscola(resource.data.escola_id));
      allow create, update: if (admin() || equipeEscola(novo().escola_id))
        && id == novo().escola_id + "_" + novo().aluno_id + "_" + string(novo().ano)
        && (resource == null || (resource.data.escola_id == novo().escola_id && resource.data.aluno_id == novo().aluno_id && resource.data.ano == novo().ano))
        && novo().keys().hasOnly(["escola_id", "municipio_id", "aluno_id", "aluno_nome", "turma_id", "turma_nome", "ano", "status", "registros", "atualizado_em", "atualizado_por"])
        && (admin() || muniDaEscola(novo().escola_id) == novo().municipio_id)
        && novo().ano is int && novo().status in ["aberto", "contato", "encaminhado", "resolvido"]
        && novo().registros is list && novo().registros.size() <= 200
        && texto(novo().aluno_nome, 80) && texto(novo().turma_nome, 80) && novo().atualizado_por == request.auth.uid;
      allow delete: if admin();
    }

    // ---------- Recursos da escola: reservas e chamado tecnico ----------
    // gestor da escola e a equipe NEWPC (admin) cadastram; quem e da escola ve; o professor licenciado reserva
    function recGestor(esc) { return admin() || gestorDaEscola(esc); }
    function recLeitor(esc, m) {
      return admin() || (ativo() && eu().perfil != "aluno" && (esc in minhasEscolas() || (eu().perfil == "secretaria" && m == eu().get("municipio_id", "-"))));
    }
    function recReserva(esc) { return admin() || gestorDaEscola(esc) || (licenciado() && esc in minhasEscolas()); }
    function texto(v, n) { return v is string && v.size() <= n; }
    match /rec_config/{esc} {
      allow get: if recLeitor(esc, muniDaEscola(esc));
      allow create, update: if recGestor(esc) && novo().keys().hasOnly(["turnos", "chave_pub", "atualizado_em", "atualizado_por"])
        && novo().get("turnos", []) is list && novo().get("turnos", []).size() <= 4
        && (novo().get("chave_pub", "") == "" || novo().chave_pub.matches("^[A-Za-z0-9]{20}$"));
    }
    // ativo (equipamento): gestor cadastra na escola dele; transferir de escola e ligar a contrato e so a equipe NEWPC (admin)
    match /rec_itens/{id} {
      allow read: if recLeitor(resource.data.escola_id, resource.data.municipio_id);
      // escola vazia = estoque do municipio (equipamento ainda nao entregue): so a NEWPC
      allow create: if camposItem() && lugarValido() && (admin() || (gestorDaEscola(novo().escola_id) && novo().contrato_id == ""));
      allow update: if recGestor(resource.data.escola_id) && novo().qr == resource.data.qr && camposItem() && lugarValido()
        && (admin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["escola_id", "municipio_id", "contrato_id"]));
      allow delete: if recGestor(resource.data.escola_id);
      // historico de movimentacao (cadastro, situacao, transferencia): so acrescenta, ninguem edita
      match /mov/{mid} {
        allow read: if recLeitor(get(/databases/$(database)/documents/rec_itens/$(id)).data.escola_id, get(/databases/$(database)/documents/rec_itens/$(id)).data.municipio_id);
        allow create: if (admin() || gestorDaEscola(getAfter(/databases/$(database)/documents/rec_itens/$(id)).data.escola_id))
          && novo().keys().hasOnly(["tipo", "de", "para", "obs", "por", "por_nome", "em"]) && novo().por == request.auth.uid && novo().em == request.time
          && novo().tipo in ["cadastro", "situacao", "transferencia", "edicao"] && texto(novo().de, 120) && texto(novo().para, 120) && texto(novo().obs, 300) && texto(novo().por_nome, 80);
        allow delete: if admin();
      }
    }
    function lugarValido() {
      return (novo().escola_id == "" && admin() && exists(/databases/$(database)/documents/municipios/$(novo().municipio_id)))
        || (novo().escola_id != "" && novo().municipio_id == muniDaEscola(novo().escola_id));
    }
    function camposItem() {
      return novo().keys().hasOnly(["escola_id", "municipio_id", "nome", "tipo", "local", "patrimonio", "marca", "modelo", "serie", "origem", "contrato_id",
          "entregue_em", "garantia_ate", "situacao", "reservavel", "obs", "qr", "criado_em", "criado_por", "atualizado_em", "atualizado_por"])
        && texto(novo().nome, 80) && novo().nome.size() > 0 && texto(novo().local, 60) && texto(novo().patrimonio, 30)
        && texto(novo().marca, 40) && texto(novo().modelo, 60) && texto(novo().serie, 60) && texto(novo().obs, 300) && texto(novo().contrato_id, 40)
        && novo().origem in ["newpc", "prefeitura", "doacao", "outro"] && novo().situacao in ["em_uso", "manutencao", "estoque", "baixado"]
        && texto(novo().entregue_em, 10) && texto(novo().garantia_ate, 10)
        && novo().reservavel is bool && novo().qr is string && novo().qr.matches("^[A-Za-z0-9]{20}$");
    }
    // contratos (locacao NEWPC, comodato, manutencao): renovacoes e prazos de SLA; so a equipe NEWPC edita, a rede do municipio le
    match /rec_contratos/{id} {
      allow read: if admin() || (ativo() && eu().perfil != "aluno" && resource.data.municipio_id == eu().get("municipio_id", "-"));
      allow write: if admin();
    }
    // busca publica por patrimonio ou numero de serie (o ID e o numero so com letras e algarismos): aponta para a etiqueta do equipamento.
    // cada gravacao mexe em um equipamento so (campo "ultimo"), e so quem cuida daquele equipamento pode mexer
    match /rec_busca/{v} {
      allow get: if true;
      allow create: if v.matches("^[A-Z0-9]{2,40}$") && camposBusca() && novo().itens.keys().hasOnly([novo().ultimo]) && cuidaDoQr(novo().ultimo);
      allow update: if camposBusca() && novo().itens.diff(resource.data.itens).affectedKeys().hasOnly([novo().ultimo]) && cuidaDoQr(novo().ultimo);
      allow delete: if admin();
    }
    function camposBusca() { return novo().keys().hasOnly(["itens", "ultimo"]) && novo().itens is map && novo().itens.size() <= 50 && novo().ultimo is string && novo().ultimo.matches("^[A-Za-z0-9]{20}$"); }
    function cuidaDoQr(k) {
      return admin() || gestorDaEscola(getAfter(/databases/$(database)/documents/rec_qr/$(k)).data.escola_id)
        || gestorDaEscola(get(/databases/$(database)/documents/rec_qr/$(k)).data.escola_id);
    }
    // cartaz da escola: lista publica dos equipamentos da escola pela chave do cartaz (impossivel de adivinhar), para escolher e abrir chamado
    match /rec_pub/{chave} {
      allow get: if true;
      allow create, update: if chave.matches("^[A-Za-z0-9]{20}$") && recGestor(novo().escola_id)
        && getAfter(/databases/$(database)/documents/rec_config/$(novo().escola_id)).data.get("chave_pub", "") == chave
        && novo().keys().hasOnly(["escola_id", "municipio_id", "escola_nome", "itens", "atualizado_em"]) && novo().itens is list && novo().itens.size() <= 1500;
      allow delete: if admin();
    }
    // etiqueta QR do equipamento: leitura publica pela chave (impossivel de adivinhar); quem nao tem login so abre ou confirma chamado
    match /rec_qr/{chave} {
      allow get: if true;
      allow list: if recLeitor(resource.data.escola_id, resource.data.municipio_id);
      allow create: if chave.matches("^[A-Za-z0-9]{20}$") && (admin() || gestorDaEscola(novo().escola_id))
        && getAfter(/databases/$(database)/documents/rec_itens/$(novo().item_id)).data.qr == chave
        && getAfter(/databases/$(database)/documents/rec_itens/$(novo().item_id)).data.escola_id == novo().escola_id
        && getAfter(/databases/$(database)/documents/rec_itens/$(novo().item_id)).data.municipio_id == novo().municipio_id;
      allow update: if (recGestor(resource.data.escola_id) && novo().item_id == resource.data.item_id && (admin() || novo().escola_id == resource.data.escola_id))
        || abrirChamadoQr(chave) || confirmarChamadoQr();
      allow delete: if recGestor(resource.data.escola_id);
    }
    function mudouQr() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function abrirChamadoQr(chave) {
      return resource.data.get("chamado_aberto", null) == null && mudouQr().hasOnly(["chamado_aberto", "chamado_status", "chamado_desde", "chamado_conf"])
        && novo().chamado_aberto is string && novo().chamado_status == "aberto" && novo().chamado_desde == request.time && novo().chamado_conf == 1
        && getAfter(/databases/$(database)/documents/rec_chamados/$(novo().chamado_aberto)).data.qr == chave
        && !exists(/databases/$(database)/documents/rec_chamados/$(novo().chamado_aberto));
    }
    function confirmarChamadoQr() {
      return resource.data.get("chamado_aberto", null) != null && mudouQr().hasOnly(["chamado_conf"])
        && novo().chamado_conf == resource.data.get("chamado_conf", 0) + 1;
    }
    match /rec_chamados/{id} {
      allow read: if recLeitor(resource.data.escola_id, resource.data.municipio_id);
      // sem login: so pela etiqueta, so se o equipamento nao tem chamado aberto, e marcando a etiqueta no mesmo lote
      allow create: if novo().keys().hasOnly(["qr", "item_id", "escola_id", "municipio_id", "item_nome", "patrimonio", "local", "problema", "descricao", "nome", "funcao", "contato", "status", "criado_em"])
        && novo().qr is string && novo().qr.matches("^[A-Za-z0-9]{20}$")
        && get(/databases/$(database)/documents/rec_qr/$(novo().qr)).data.get("chamado_aberto", null) == null
        && getAfter(/databases/$(database)/documents/rec_qr/$(novo().qr)).data.chamado_aberto == id
        && novo().item_id == get(/databases/$(database)/documents/rec_qr/$(novo().qr)).data.item_id
        && novo().escola_id == get(/databases/$(database)/documents/rec_qr/$(novo().qr)).data.escola_id
        && novo().municipio_id == get(/databases/$(database)/documents/rec_qr/$(novo().qr)).data.municipio_id
        && novo().status == "aberto" && novo().criado_em == request.time
        && texto(novo().problema, 40) && texto(novo().descricao, 1000) && texto(novo().nome, 80) && novo().nome.size() >= 2
        && texto(novo().funcao, 30) && texto(novo().contato, 40) && texto(novo().item_nome, 80) && texto(novo().patrimonio, 30) && texto(novo().local, 60);
      allow update: if recGestor(resource.data.escola_id) && mudouCh().hasOnly(["status", "resposta", "confirmacoes", "atendido_por", "atendido_nome", "atualizado_em", "atendimento_em", "resolvido_em"])
        && novo().status in ["aberto", "em_atendimento", "resolvido"] && texto(novo().get("resposta", ""), 1000);
      allow delete: if admin();
    }
    function mudouCh() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // reserva: o ID e equipamento_data_turno_aula, entao duas pessoas nao reservam a mesma aula (a segunda gravacao vira update e e negada)
    match /rec_reservas/{id} {
      allow read: if (logado() && resource.data.uid == request.auth.uid) || recLeitor(resource.data.escola_id, resource.data.municipio_id);
      allow create: if recReserva(novo().escola_id) && novo().uid == request.auth.uid
        && novo().keys().hasOnly(["item_id", "item_nome", "escola_id", "municipio_id", "data", "turno", "aula", "uid", "nome", "turma", "atividade", "criado_em"])
        && novo().data is string && novo().data.matches("^20[0-9]{2}-[01][0-9]-[0-3][0-9]$") && novo().turno in ["M", "V", "N", "I"]
        && novo().aula is int && novo().aula >= 1 && novo().aula <= 12
        && id == novo().item_id + "_" + novo().data + "_" + novo().turno + "_" + string(novo().aula)
        && get(/databases/$(database)/documents/rec_itens/$(novo().item_id)).data.escola_id == novo().escola_id
        && get(/databases/$(database)/documents/rec_itens/$(novo().item_id)).data.reservavel == true
        && novo().municipio_id == muniDaEscola(novo().escola_id) && novo().criado_em == request.time
        && texto(novo().nome, 80) && texto(novo().turma, 60) && texto(novo().atividade, 120) && texto(novo().get("item_nome", ""), 80);
      allow delete: if (logado() && resource.data.uid == request.auth.uid) || recGestor(resource.data.escola_id);
    }

    // campanhas educativas do Portal do Educador (dengue, transito, Outubro Rosa...): passam em todas as TVs; so o administrador edita
    match /tv_campanhas/{id} {
      allow get: if true;
      allow list, write: if admin();
    }
    // comunicados da secretaria: um canal por municipio; so a secretaria (e o administrador) publica
    match /tv_canais/{id} {
      allow get: if true;
      allow list: if admin() || (ativo() && eu().perfil != "aluno" && resource.data.municipio_id == eu().get("municipio_id", "-"));
      allow create: if (admin() || (ativo() && eu().perfil != "aluno" && novo().municipio_id == eu().get("municipio_id", "-")))
        && novo().avisos is list && novo().avisos.size() == 0;
      allow update: if (admin() || (ativo() && eu().perfil == "secretaria" && resource.data.municipio_id == eu().get("municipio_id", "-")))
        && novo().municipio_id == resource.data.municipio_id && novo().avisos is list && novo().avisos.size() <= 30;
      allow delete: if admin();
    }

    // lista importada de professores (chave = e-mail em minusculas)
    match /pre_cadastros/{email} {
      allow read: if admin() || (emailVerificado() && meuEmail() == email)
        // o gestor ve os convites da equipe de apoio da escola dele (e se um e-mail ainda esta livre)
        || (ativo() && eu().perfil == "gestor" && (resource == null || (perfilApoio(resource.data.get("perfil", "")) && gestorDaEscola(resource.data.get("escola_id", "-")))));
      allow write: if admin();
      // o gestor convida a equipe de apoio da escola dele (portaria e secretaria escolar), so para a propria escola
      allow create, update: if gestorDaEscola(novo().escola_id) && perfilApoio(novo().perfil)
        && (resource == null || (perfilApoio(resource.data.get("perfil", "")) && gestorDaEscola(resource.data.get("escola_id", "-"))))
        && novo().keys().hasOnly(["nome", "email", "perfil", "status", "licenca_tipo", "municipio_id", "municipio_nome", "escola_id", "escola_nome", "escolas_ids", "escolas_nomes", "turmas_ids", "convidado_por", "convidado_por_nome", "atualizado_em", "atualizado_por"])
        && novo().email == email && email.matches("^[^@ ]+@[^@ ]+[.][^@ ]+$") && email == email.lower()
        && novo().status == "ativo" && novo().licenca_tipo == "institucional" && novo().escolas_ids == [novo().escola_id] && novo().turmas_ids == []
        && novo().municipio_id == muniDaEscola(novo().escola_id) && novo().convidado_por == request.auth.uid && texto(novo().nome, 80);
      allow delete: if gestorDaEscola(resource.data.get("escola_id", "-")) && perfilApoio(resource.data.get("perfil", ""));
    }

    // registro de uso: 1 documento por pessoa por dia (alimenta o Painel do administrador)
    match /acessos_dia/{id} {
      allow read: if admin();
      allow create, update: if logado() && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.dia + "_" + request.auth.uid;
    }

    // acervo: metadados dos arquivos (os arquivos ficam no Cloudflare R2)
    match /acervo/{id} {
      allow read: if admin() || (licenciado() && resource.data.publicado == true)
        || (aluno() && resource.data.publicado == true && resource.data.modulo in ["datas", "historias"] && alunoPode(resource.data.modulo));
      allow write: if admin();
    }

    // mural de notícias: a NEWPC publica; quem entra no Portal lê as publicadas (público, municípios e datas são filtrados na tela)
    match /noticias/{id} {
      allow read: if admin() || (logado() && resource.data.publicado == true);
      allow write: if admin();
    }
    match /noticias_reacoes/{id} {
      allow read: if admin() || (logado() && resource.data.uid == request.auth.uid);
      allow create, update: if logado() && id == novo().noticia_id + "_" + request.auth.uid
        && novo().keys().hasOnly(["noticia_id", "uid", "reacao", "perfil", "em"])
        && novo().uid == request.auth.uid && novo().reacao in ["amei", "gostei", "meh", "nao"] && novo().perfil == eu().perfil
        && exists(/databases/$(database)/documents/noticias/$(novo().noticia_id))
        && get(/databases/$(database)/documents/noticias/$(novo().noticia_id)).data.publicado == true;
      allow delete: if admin() || (logado() && resource.data.uid == request.auth.uid);
    }

    // prova online: só as funções criam e corrigem; o aluno lê as questões (sem gabarito) e grava as próprias respostas no prazo
    function provaOnline(id) { return get(/databases/$(database)/documents/provas_online/$(id)).data; }
    // aluno da prova: pela matrícula (claim aluno_id, gravado só pelas funções) ou, nas contas antigas, pelo uid
    function meuAlunoId() { return request.auth.token.get("aluno_id", ""); }
    function souTentativa(t) { return request.auth.uid == t || (meuAlunoId() != "" && t == "m-" + meuAlunoId()); }
    match /provas_online/{id} {
      allow read: if admin() || (logado() && (resource.data.professor_uid == request.auth.uid || request.auth.uid in resource.data.alunos_uids
        || (meuAlunoId() != "" && meuAlunoId() in resource.data.get("alunos_ids", []))));
      allow write: if false;
      match /po_tentativas/{uid} {
        allow read: if admin() || (logado() && (souTentativa(uid) || provaOnline(id).professor_uid == request.auth.uid));
        allow update: if logado() && souTentativa(uid) && resource.data.status == "em_andamento"
          && request.time < resource.data.prazo + duration.value(2, "m")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["respostas", "desvios", "eventos", "status", "bloqueado_em", "atualizado_em",
               "sessao", "disp", "aparelho", "trocas"])
          // um aparelho por vez: a sessao ativa, o aparelho e quantas vezes trocou (so sobe de 1 em 1)
          && request.resource.data.get("sessao", "") is string && request.resource.data.get("sessao", "").size() <= 40
          && request.resource.data.get("disp", "") is string && request.resource.data.get("disp", "").size() <= 40
          && request.resource.data.get("aparelho", "") is string && request.resource.data.get("aparelho", "").size() <= 40
          && request.resource.data.get("trocas", 0) is int
          && request.resource.data.get("trocas", 0) >= resource.data.get("trocas", 0)
          && request.resource.data.get("trocas", 0) <= resource.data.get("trocas", 0) + 1
          && request.resource.data.respostas is map && request.resource.data.respostas.size() <= 100
          && request.resource.data.desvios is int && request.resource.data.desvios >= resource.data.desvios
          && request.resource.data.eventos is list && request.resource.data.eventos.size() <= 80
          && (request.resource.data.status == "em_andamento"
              || (request.resource.data.status == "bloqueada" && request.resource.data.desvios > resource.data.avisos_max));
        allow create, delete: if false;
      }
      match /po_resultados/{uid} {
        allow read: if admin() || (logado() && (provaOnline(id).professor_uid == request.auth.uid
          || (souTentativa(uid) && ((provaOnline(id).fecha_em < request.time && provaOnline(id).get("notas", "fim") != "reter") || provaOnline(id).get("nota_liberada", false) == true))));
        allow write: if false;
      }
      // sala de espera ("aplicar agora"): o aluno avisa que entrou e está pronto; o professor vê quem já está na sala antes de iniciar
      match /po_sala/{uid} {
        allow read: if admin() || (logado() && (souTentativa(uid) || provaOnline(id).professor_uid == request.auth.uid));
        allow create, update: if logado() && souTentativa(uid) && provaOnline(id).status == "agendada"
          && (request.auth.uid in provaOnline(id).get("alunos_uids", []) || (meuAlunoId() != "" && meuAlunoId() in provaOnline(id).get("alunos_ids", [])))
          && request.resource.data.keys().hasOnly(["nome", "aparelho", "em", "pronto", "foto"])
          && request.resource.data.em == request.time
          && request.resource.data.get("nome", "") is string && request.resource.data.get("nome", "").size() <= 80
          && request.resource.data.get("aparelho", "") is string && request.resource.data.get("aparelho", "").size() <= 40
          && request.resource.data.get("pronto", false) is bool && request.resource.data.get("foto", false) is bool;
        allow delete: if false;
      }
    }
    match /provas_online_gab/{id} {
      allow read: if admin() || (logado() && resource.data.professor_uid == request.auth.uid);
      allow write: if false;
    }

    // atividades prontas (Banco Curricular): professor com licença lê as publicadas; só o administrador e as funções gravam
    match /atividades/{id} {
      allow read: if admin() || (licenciado() && resource.data.publicado == true);
      allow write: if admin();
    }
    // arquivos do Drive que o administrador excluiu do Portal (a sincronização não traz de novo)
    match /atividades_ignoradas/{id} { allow read, write: if admin(); }
    match /atividades_reacoes/{id} {
      allow read: if admin() || (logado() && resource.data.uid == request.auth.uid);
      allow create, update: if logado() && id == novo().atividade_id + "_" + request.auth.uid
        && novo().keys().hasOnly(["atividade_id", "uid", "reacao", "perfil", "em"])
        && novo().uid == request.auth.uid && novo().reacao in ["amei", "gostei", "meh", "nao"] && novo().perfil == eu().perfil
        && (admin() || licenciado())
        && exists(/databases/$(database)/documents/atividades/$(novo().atividade_id))
        && get(/databases/$(database)/documents/atividades/$(novo().atividade_id)).data.publicado == true;
      allow delete: if admin() || (logado() && resource.data.uid == request.auth.uid);
    }

    // datas comemorativas: catálogo da NEWPC; quem entra no Portal lê as publicadas (o kit aponta para conteúdos com regras próprias)
    match /datas_comemorativas/{id} {
      allow read: if admin() || (logado() && resource.data.publicado == true);
      allow write: if admin();
    }

    // pesquisa rápida (noticias com tipo "pesquisa"): uma resposta por pessoa, sem trocar depois; anônima não leva nome nem escola
    function pesquisa(nid) { return get(/databases/$(database)/documents/noticias/$(nid)).data; }
    function pesquisaAberta(p) {
      return p.get("tipo", "") == "pesquisa" && p.get("publicado", false) == true
        && (p.get("fim", null) == null || p.fim > request.time) && p.get("opcoes", []) is list;
    }
    match /pesquisa_respostas/{id} {
      allow read: if admin() || (logado() && resource.data.uid == request.auth.uid);
      allow create: if logado() && id == novo().noticia_id + "_" + request.auth.uid
        && novo().keys().hasOnly(["noticia_id", "uid", "opcao", "perfil", "municipio_id", "nome", "escola_nome", "em"])
        && novo().uid == request.auth.uid && novo().perfil == eu().perfil
        && novo().municipio_id == eu().get("municipio_id", null) && novo().em == request.time
        && pesquisaAberta(pesquisa(novo().noticia_id))
        && novo().opcao is int && novo().opcao >= 0 && novo().opcao < pesquisa(novo().noticia_id).opcoes.size()
        && (pesquisa(novo().noticia_id).get("identificada", false) == true
              ? (novo().nome is string && novo().nome.size() <= 120 && novo().escola_nome is string && novo().escola_nome.size() <= 160)
              : (!("nome" in novo()) && !("escola_nome" in novo())));
      allow delete: if admin();
    }

    // videos: catalogo (os videos ficam no YouTube); o professor so ve os publicados
    match /videos/{id} {
      allow read: if admin() || (licenciado() && resource.data.publicado == true)
        || (alunoPode("videos") && resource.data.publicado == true && resource.data.get("para_alunos", false) == true);
      allow write: if admin();
    }

    // reação ao vídeo: um voto por pessoa e vídeo ({video}_{uid}); a contagem vai para videos/{id}.reacoes pela função contarReacaoVideo
    match /videos_reacoes/{id} {
      allow read: if admin() || (logado() && resource.data.uid == request.auth.uid);
      allow create, update: if logado() && id == novo().video_id + "_" + request.auth.uid
        && novo().keys().hasOnly(["video_id", "uid", "reacao", "perfil", "em"])
        && novo().uid == request.auth.uid && novo().reacao in ["amei", "gostei", "meh", "nao"] && novo().perfil == eu().perfil
        && exists(/databases/$(database)/documents/videos/$(novo().video_id))
        && get(/databases/$(database)/documents/videos/$(novo().video_id)).data.publicado == true
        && (admin() || licenciado() || (alunoPode("videos") && get(/databases/$(database)/documents/videos/$(novo().video_id)).data.get("para_alunos", false) == true));
      allow delete: if admin() || (logado() && resource.data.uid == request.auth.uid);
    }

    // jogos: catalogo (os jogos ficam em jogos.portaldoeducador.com.br ou em sites externos)
    match /jogos/{id} {
      allow read: if admin() || (licenciado() && resource.data.publicado == true)
        || (alunoPode("jogos") && resource.data.publicado == true && resource.data.get("para_alunos", false) == true);
      allow write: if admin();
    }

    // Dicas de IA: catalogo das aplicacoes do IA Studio (as aplicacoes ficam em studio.portaldoeducador.com.br)
    match /ia_apps/{id} {
      allow read: if admin() || (licenciado() && resource.data.publicado == true);
      allow write: if admin();
    }
    // Meus materiais do IA Studio: o pedido que o professor montou (para gerar de novo ou variar). So o dono le e mexe.
    match /ia_materiais/{id} {
      allow read, delete: if logado() && resource.data.uid == request.auth.uid;
      allow create: if (licenciado() || admin()) && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["uid", "titulo", "area", "area_nome", "pasta", "modo", "valores", "turma_id", "turma_nome", "ia", "favorito", "criado_em", "usado_em",
                                                 "entrega", "tipo", "tipo_nome", "tema", "serie", "bncc", "motor"])
        && request.resource.data.get("tema", "") is string && request.resource.data.get("tema", "").size() <= 120
        && request.resource.data.get("bncc", "") is string && request.resource.data.get("bncc", "").size() <= 120
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 160
        && request.resource.data.pasta is string && request.resource.data.pasta.size() <= 80
        && request.resource.data.valores is map && request.resource.data.valores.size() <= 6
        && request.resource.data.favorito == false;
      allow update: if logado() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["favorito", "ia", "usado_em", "titulo"])
        && request.resource.data.favorito is bool;
    }

    // configuracao do Portal (ex.: quais botoes estao liberados)
    match /config/{id} { allow read: if licenciado() || aluno(); allow write: if admin(); }
    // backup do banco para o Google Drive: so o administrador ve; so as funcoes gravam
    match /backup_config/{id} { allow read: if admin(); allow write: if false; }
    match /backups_log/{id} { allow read: if admin(); allow write: if false; }
    // dominios de e-mail dos alunos de cada rede (chave = dominio). O aluno so consulta o proprio dominio.
    match /dominios_aluno/{dominio} {
      allow get: if admin() || (temEmail() && meuDominio() == dominio);
      allow list, write: if admin();
    }

    // dados de alunos (LGPD): so professores das mesmas escolas leem; o professor cadastra alunos nas turmas que criou
    match /alunos/{id} {
      // gestor da escola tambem le (carteirinhas e portaria)
      allow read: if admin() || (vinculado() && resource.data.escola_id in minhasEscolas()) || entradaEscola(resource.data.escola_id);
      allow create: if admin() || (vinculado() && novo().criado_por == request.auth.uid
        && novo().escola_id in minhasEscolas() && !("alertas" in novo()) && !("situacao" in novo())
        && get(/databases/$(database)/documents/turmas/$(novo().turma_id)).data.criado_por == request.auth.uid)
        // Ficha do Aluno: a gestão e a secretaria escolar matriculam e atualizam os alunos da própria escola
        || (equipeEscola(novo().escola_id) && novo().criado_por == request.auth.uid
          && novo().keys().hasOnly(camposAlunoEscola()) && alunoEscolaOk());
      allow update: if admin() || (vinculado() && resource.data.get("criado_por", "") == request.auth.uid
        && novo().criado_por == request.auth.uid && novo().escola_id == resource.data.escola_id && novo().turma_id == resource.data.turma_id
        && novo().get("alertas", null) == resource.data.get("alertas", null) && novo().get("situacao", null) == resource.data.get("situacao", null))
        || (equipeEscola(resource.data.escola_id) && novo().escola_id == resource.data.escola_id
          && novo().get("criado_por", "") == resource.data.get("criado_por", "")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposAlunoEscola()) && alunoEscolaOk());
      allow delete: if admin();
    }
    // campos que a escola grava no aluno (o professor lê): nada de saúde aqui, só os alertas curtos escolhidos pela gestão
    function camposAlunoEscola() {
      return ["nome", "nome_social", "matricula", "inep_aluno", "nascimento", "situacao", "turma_id", "turma_nome", "escola_id", "escola_nome",
        "municipio_id", "municipio_nome", "ano_letivo", "status", "alertas", "ficha_pct", "foto", "saida_em", "origem", "email", "criado_em", "criado_por", "atualizado_em", "atualizado_por"];
    }
    function alunoEscolaOk() {
      return turmaDoc(novo().turma_id).escola_id == novo().escola_id
        && novo().nome is string && novo().nome.size() >= 2 && novo().nome.size() <= 80
        && texto(novo().get("nome_social", ""), 80) && texto(novo().get("matricula", ""), 40) && texto(novo().get("inep_aluno", ""), 20)
        && (novo().get("email", "") == "" || (novo().email is string && novo().email.size() <= 120 && novo().email.matches("^[^@\\s]+@[^@\\s]+[.][^@\\s]+$")))
        && (novo().get("nascimento", "") == "" || novo().nascimento.matches("^(19|20)[0-9]{2}-[01][0-9]-[0-3][0-9]$"))
        && novo().get("situacao", "cursando") in ["cursando", "remanejado", "transferido", "abandono", "concluido"]
        && novo().get("status", "ativo") in ["ativo", "inativo"]
        && novo().get("alertas", []) is list && novo().get("alertas", []).size() <= 8
        && (novo().get("foto", "") == "" || novo().foto.matches("^fotos_alunos/" + novo().escola_id + "/[A-Za-z0-9_-]{1,64}/[A-Za-z0-9_-]{1,60}[.]jpg$"))
        && (novo().get("saida_em", "") == "" || dataOk(novo().saida_em))
        && novo().atualizado_por == request.auth.uid;
    }

    match /avaliacoes/{id} {
      // a prova traz o gabarito: só o professor dono, a gestão da escola e a secretaria do município leem
      // (a prova por código sem login foi aposentada; o aluno faz a Prova online, com o gabarito guardado à parte)
      allow read: if admin() || (logado() && resource.data.get("professor_uid", "") == request.auth.uid)
        || gestorDaEscola(resource.data.get("escola_id", "-")) || secretariaDoMuni(resource.data.get("municipio_id", "-"));
      allow create: if professor() && request.resource.data.professor_uid == request.auth.uid;
      allow update, delete: if admin() || (professor() && resource.data.professor_uid == request.auth.uid);
    }

    // Documentação do Portal (manuais, POPs, técnico): a equipe NEWPC vê tudo; "todos" aparece em Ajuda para quem tem acesso ativo
    match /documentos/{id} {
      allow read: if admin() || (ativo() && resource.data.get("publico", "admin") == "todos");
      allow write: if admin();
    }

    // respostas das provas: so o professor dono da prova corrige; gestor da escola e secretaria do municipio acompanham
    function prova(av) { return get(/databases/$(database)/documents/avaliacoes/$(av)).data; }
    function donoDaProva(av) { return logado() && prova(av).professor_uid == request.auth.uid; }
    match /respostas/{id} {
      // quem lança é o professor dono da prova (Corretor de Gabarito); ninguém grava sem login
      allow create: if admin() || (logado() && donoDaProva(novo().avaliacao_id) && novo().keys().hasOnly(["avaliacao_id", "avaliacao_titulo",
          "turma_id", "turma_nome", "escola_id", "municipio_id", "aluno_id", "aluno_nome", "respostas", "nota_objetivas", "nota_final", "nota_dissertativas",
          "dissertativa_pendente", "status", "origem", "corrigida_em", "corrigida_por", "enviada_em", "criado_em"]));
      allow read: if admin() || donoDaProva(resource.data.avaliacao_id)
        || gestorDaEscola(prova(resource.data.avaliacao_id).get("escola_id", "-")) || secretariaDoMuni(prova(resource.data.avaliacao_id).get("municipio_id", "-"));
      allow update, delete: if admin() || donoDaProva(resource.data.avaliacao_id);
    }

    // ---------- Portal Maestro: historico das aulas ----------
    match /maestro_aulas/{id} {
      allow create: if professor() && request.resource.data.professor_uid == request.auth.uid;
      allow read: if admin() || (professor() && resource.data.professor_uid == request.auth.uid);
      allow update, delete: if admin();
    }
    // ================= BIBLIOTECA =================
    // Acervo publicado: professor ativo lê. A triagem (lista do Drive antigo e decisões de licença) é só do administrador.
    // Aluno: só as estantes Aprender brincando e Gibiteca.
    match /biblioteca/{id} {
      allow read: if admin() || (naoAluno() && resource.data.publicado == true)
        || (alunoPode("biblioteca") && resource.data.publicado == true && resource.data.secao in ["aprender", "gibiteca"])
        // Histórias Educativas: estante da Biblioteca liberada pelo botão Histórias do plano do aluno
        || (alunoPode("historias") && resource.data.publicado == true && resource.data.secao == "historias");
      allow write: if admin();
    }
    match /biblioteca_triagem/{id} { allow read, write: if admin(); }
    // reação aos títulos da Biblioteca: um voto por pessoa ({livro}_{uid}); quem pode ler o título pode reagir
    function podeLerLivro(l) {
      return admin() || (naoAluno() && l.publicado == true)
        || (alunoPode("biblioteca") && l.publicado == true && l.secao in ["aprender", "gibiteca"])
        || (alunoPode("historias") && l.publicado == true && l.secao == "historias");
    }
    match /biblioteca_reacoes/{id} {
      allow read: if admin() || (logado() && resource.data.uid == request.auth.uid);
      allow create, update: if logado() && id == novo().livro_id + "_" + request.auth.uid
        && novo().keys().hasOnly(["livro_id", "uid", "reacao", "perfil", "em"])
        && novo().uid == request.auth.uid && novo().reacao in ["amei", "gostei", "meh", "nao"] && novo().perfil == eu().perfil
        && exists(/databases/$(database)/documents/biblioteca/$(novo().livro_id))
        && podeLerLivro(get(/databases/$(database)/documents/biblioteca/$(novo().livro_id)).data);
      allow delete: if admin() || (logado() && resource.data.uid == request.auth.uid);
    }
    // ================= DESENHOS PARA COLORIR =================
    match /colorir/{id} {
      allow read: if admin() || (naoAluno() && resource.data.publicado == true) || (alunoPode("colorir") && resource.data.publicado == true);
      allow write: if admin();
    }
    // ================= DICAS DO PROFESSOR =================
    // Professor ativo envia; a equipe (admin) revisa e publica. Publicadas aparecem para toda a rede.
    match /dicas_envios/{id} {
      allow read: if admin() || (logado() && resource.data.autor_uid == request.auth.uid) || (naoAluno() && resource.data.status == "publicado");
      allow create: if naoAluno() && request.resource.data.autor_uid == request.auth.uid && request.resource.data.status == "novo"
        && request.resource.data.keys().hasOnly(["tipo", "titulo", "texto", "disciplina", "etapa", "links", "arquivos", "credito",
             "autor_uid", "autor_nome", "autor_email", "escola_nome", "municipio_nome", "status", "criado_em"])
        && request.resource.data.tipo in ["dica", "app", "material", "atividade"]
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 4 && request.resource.data.titulo.size() <= 120
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 4000
        && request.resource.data.links is list && request.resource.data.links.size() <= 5
        && request.resource.data.arquivos is list && request.resource.data.arquivos.size() <= 5
        && request.resource.data.autor_email == request.auth.token.get("email", "")
        && request.resource.data.criado_em == request.time;
      allow update: if admin();
      allow delete: if admin() || (logado() && resource.data.autor_uid == request.auth.uid && resource.data.status == "novo");
    }
    // ================= DICA DO ALUNO =================
    // Aluno envia texto e até 2 links (sem arquivo). A equipe revisa; ao publicar, copia só o que pode aparecer
    // (primeiro nome e escola) para dicas_alunos_pub. Nome completo e e-mail do aluno nunca ficam públicos.
    match /dicas_alunos/{id} {
      allow read: if admin() || (logado() && resource.data.autor_uid == request.auth.uid);
      allow create: if alunoPode("dicasaluno") && request.resource.data.autor_uid == request.auth.uid && request.resource.data.status == "novo"
        && request.resource.data.keys().hasOnly(["tipo", "titulo", "texto", "disciplina", "links", "autor_uid", "autor_nome", "autor_email",
             "escola_nome", "municipio_id", "municipio_nome", "status", "criado_em"])
        && request.resource.data.tipo in ["estudo", "app", "curiosidade", "desafio"]
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 4 && request.resource.data.titulo.size() <= 100
        && request.resource.data.texto is string && request.resource.data.texto.size() >= 10 && request.resource.data.texto.size() <= 1500
        && request.resource.data.links is list && request.resource.data.links.size() <= 2
        && request.resource.data.autor_email == request.auth.token.get("email", "")
        && request.resource.data.municipio_id == eu().municipio_id
        && request.resource.data.criado_em == request.time;
      allow update: if admin();
      allow delete: if admin() || (logado() && resource.data.autor_uid == request.auth.uid && resource.data.status == "novo");
    }
    match /dicas_alunos_pub/{id} { allow read: if ativo(); allow write: if admin(); }
    // ================= FORMAÇÃO CONTINUADA (ex-Academia do Educador) =================
    // Papéis editoriais vêm de custom claims (papel: admin | editor); o administrador do Portal também edita.
    function fPapel() { return logado() ? request.auth.token.get('papel', '') : ''; }
    function fDono(uid) { return logado() && request.auth.uid == uid; }
    function fAdmin() { return fPapel() == 'admin' || admin(); }
    function fEditor() { return fPapel() in ['admin', 'editor'] || admin(); }
    function fCurso(cid) { return get(/databases/$(database)/documents/cursos/$(cid)).data; }
    function fPublicado(cid) { return fCurso(cid).status == 'publicado'; }
    function fEditavel(d) { return d.status != 'publicado' && !d.get('historicoPublicado', false) && !('publicadoEm' in d); }
    function fEditarConteudo(cid) { return fEditor() && fEditavel(fCurso(cid)); }
    match /equipe/{uid} { allow read: if fEditor(); allow write: if false; }
    match /auditoria/{id} { allow read: if fAdmin(); allow write: if false; }
    match /cursos/{cid} {
      allow read: if resource.data.status == 'publicado' || fEditor();
      allow create: if fEditor() && request.resource.data.status == 'rascunho'
        && !('historicoPublicado' in request.resource.data) && !('publicadoEm' in request.resource.data);
      // Publicação e congelamento apenas via publicarCurso (função no servidor).
      allow update: if fEditor() && fEditavel(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'historicoPublicado', 'publicadoEm']);
      allow delete: if false;
      match /modulos/{id} { allow read: if fPublicado(cid) || fEditor(); allow write: if fEditarConteudo(cid); }
      match /aulas/{id} { allow read: if fPublicado(cid) || fEditor(); allow write: if fEditarConteudo(cid); }
      match /questoes/{id} { allow read: if fEditor(); allow write: if fEditarConteudo(cid); }
      match /gabarito/{id} { allow read: if false; allow write: if fEditarConteudo(cid); }
    }
    match /trilhas/{id} {
      allow read: if resource.data.status == 'publicado' || fEditor();
      allow create: if fEditor() && (request.resource.data.status != 'publicado' || fAdmin());
      allow update: if fAdmin() || (fEditor() && resource.data.status != 'publicado' && request.resource.data.status != 'publicado');
      allow delete: if fAdmin();
    }
    match /users/{uid} {
      allow read: if fDono(uid);
      allow create, update: if fDono(uid)
        && request.resource.data.keys().hasOnly(['nome', 'email', 'fotoURL', 'municipio', 'escola', 'cargo', 'cpf', 'aceiteTermos', 'criadoEm', 'ultimoAcesso'])
        && request.resource.data.get('nome', '') is string && request.resource.data.get('nome', '').size() <= 160
        && request.resource.data.get('cpf', '') is string && request.resource.data.get('cpf', '').size() <= 20
        && request.resource.data.get('municipio', '') is string && request.resource.data.get('municipio', '').size() <= 160
        && request.resource.data.get('escola', '') is string && request.resource.data.get('escola', '').size() <= 240
        && request.resource.data.get('email', '') == request.auth.token.get('email', '');
      allow delete: if false;
      match /progresso/{cid} { allow read: if fDono(uid); allow write: if false; }
      match /tentativas/{cid} { allow read: if fDono(uid); allow write: if false; }
      match /anotacoes/{aid} {
        allow read, delete: if fDono(uid);
        allow create, update: if fDono(uid) && request.resource.data.keys().hasOnly(['texto', 'atualizadoEm'])
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 12000
          && request.resource.data.atualizadoEm == request.time;
      }
      match /provas/{id} { allow read, write: if false; }
      match /sessoes/{id} { allow read, write: if false; }
      match /emissoes/{id} { allow read, write: if false; }
    }
    // Certificado completo só para o titular e o administrador; a consulta pública passa pela função consultarCertificado.
    match /certificados/{codigo} { allow read: if fAdmin() || (logado() && resource.data.uid == request.auth.uid); allow write: if false; }
    match /cpfs/{cpf} { allow read, write: if false; }
  }
}
